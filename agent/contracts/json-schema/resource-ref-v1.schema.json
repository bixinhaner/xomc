{
  "$id": "https://agentstudio.example/schemas/resource-ref-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "role"
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "label": {
      "type": "string",
      "maxLength": 200
    }
  }
}
