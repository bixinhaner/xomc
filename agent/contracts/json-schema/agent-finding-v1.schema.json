{
  "$id": "https://agentstudio.example/schemas/agent-finding-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentFinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioKey",
    "scenarioVersion",
    "title",
    "summary",
    "severity",
    "confidence",
    "facts",
    "hypotheses",
    "resourceRefs",
    "details",
    "suggestedActions",
    "presentation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "scenarioKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scenarioVersion": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "confidence",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          }
        }
      }
    },
    "resourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "resource-ref-v1.schema.json"
      }
    },
    "details": {
      "type": "object"
    },
    "suggestedActions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "label"
        ],
        "properties": {
          "type": {
            "enum": [
              "open-finding",
              "open-resource",
              "continue-agent",
              "dismiss",
              "copy-summary"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "resourceRole": {
            "type": "string",
            "maxLength": 64
          },
          "promptKey": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces",
        "sections"
      ],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "enum": [
              "summary",
              "impact",
              "facts",
              "hypotheses",
              "details",
              "resources",
              "suggestedActions"
            ]
          }
        },
        "icon": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}
