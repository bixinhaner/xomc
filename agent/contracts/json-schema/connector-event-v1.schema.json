{
  "$id": "https://agentstudio.example/schemas/connector-event-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "eventId",
    "eventType",
    "source",
    "occurredAt",
    "traceId",
    "integrationPack",
    "handbookDigest",
    "resources",
    "data"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+\\.v[0-9]+$",
      "maxLength": 160
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64
    },
    "integrationPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "digest"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "handbookDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tenantRef": {
      "type": "string",
      "maxLength": 160
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "resource-ref-v1.schema.json"
      }
    },
    "data": {
      "type": "object",
      "maxProperties": 128
    }
  }
}
