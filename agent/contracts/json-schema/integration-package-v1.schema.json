{
  "$id": "https://agentstudio.example/schemas/integration-package-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationPackageManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "compatibility",
    "runtime",
    "contents"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentstudio.integration/v1"
    },
    "kind": {
      "const": "IntegrationPackage"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "version",
        "owner",
        "description"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,159}$"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "owner": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "connectorType",
        "agentStudio"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0"
        },
        "connectorType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "connectorVersion": {
          "type": "string",
          "maxLength": 80
        },
        "agentStudio": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentMode",
        "runtimeClasses",
        "locale",
        "timezone"
      ],
      "properties": {
        "agentMode": {
          "type": "string",
          "maxLength": 120
        },
        "runtimeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "locale": {
          "type": "string",
          "maxLength": 32
        },
        "timezone": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarios",
        "prompts",
        "schemas",
        "presentation"
      ],
      "properties": {
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^scenarios/"
          }
        },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^prompts/"
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^schemas/"
          }
        },
        "presentation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^presentation/"
          }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tests/"
          }
        }
      }
    }
  }
}
