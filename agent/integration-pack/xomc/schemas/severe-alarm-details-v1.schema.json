{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alarmId",
    "alarmCode",
    "affectedDeviceIds",
    "impactCategory"
  ],
  "properties": {
    "alarmId": {
      "type": "string",
      "maxLength": 160
    },
    "alarmCode": {
      "type": "string",
      "maxLength": 160
    },
    "affectedDeviceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "impactCategory": {
      "enum": [
        "availability",
        "performance",
        "configuration",
        "connectivity",
        "unknown"
      ]
    },
    "relatedChangeSummary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 800
    }
  }
}
