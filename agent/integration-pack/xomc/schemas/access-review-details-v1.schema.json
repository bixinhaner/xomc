{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "candidateId",
    "policyChecks",
    "missingEvidence"
  ],
  "properties": {
    "recommendation": {
      "enum": [
        "approve",
        "reject",
        "need_more_evidence"
      ]
    },
    "candidateId": {
      "type": "string",
      "maxLength": 160
    },
    "policyChecks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "result"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 120
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
