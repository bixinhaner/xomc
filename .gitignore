!.claude/settings.json
!.claude/skills-marketplace/
.claude/settings.local.json

# Qoder (AI tool generated files)
.qoder/

run/logs

# Local scratch / one-off analysis scripts
tmp/
/outputs/

# Database backups (T-0042 W1.8) — 备份产物不入库
backups/

# Playwright MCP transient artifacts (snapshots / console logs)
.playwright-mcp/

# T-0118 TLS 自签证书 + 本地化 nginx TLS conf — 不入库
deployments/docker/certs/
deployments/docker/default-tls.conf

# 离线交付构建产物（勿入库；目录由构建脚本自动创建）
deployments/release/dist/
deployments/release/images-cache/
deployments/release/docker-cache/
deployments/release/archive/
deployments/release/bundle/docker/docker-*.tgz
deployments/release/.serve.*

deployments/docker/Tiles/
deployments/docker/.env

# OMC 全局 API 密钥(由 app 启动期签发,永不入库;详见 omcgo/CLAUDE.md §5.6)
.api-key
**/.api-key
**/*.api-key.tmp

# T-0178 / T-0180 自定义 XML 的备份/暂存/删除残留 — 开发机本地状态,不入库;
# 容器运行时 host bind mount 遮盖镜像层,这些文件就算入库也不会被加载。
omcgo/data/**/*.deleted.*
omcgo/data/**/*.bak.*
omcgo/data/**/*.tmp.*

# 根目录散落的临时截图(playwright / 手动调试用,不入库;
# 子目录里前端 / 文档资产里的 png 不受影响,因为前缀 / 限定根目录)
/*.png

# Migration baseline backups (consolidation snapshots, kept locally for rollback only)
omcgo/migrations.backup-*/

# 本机资源规划（plan-resources.sh 生成，机器相关，不入库）
deployments/docker/resources.env
deployments/docker/retention.sql
node_modules
