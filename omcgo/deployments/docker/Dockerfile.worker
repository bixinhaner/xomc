FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

ENV GOPROXY=https://goproxy.cn,direct

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/bin/omcgo-worker ./cmd/worker

# ---

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

# Create log directory with proper permissions
RUN mkdir -p /var/log/omcgo && chmod 777 /var/log/omcgo

COPY --from=builder /build/bin/omcgo-worker /usr/local/bin/omcgo-worker
COPY --from=builder /build/cmd/worker/etc/config.prod.yaml /etc/omcgo/worker.yaml

EXPOSE 9092

ENTRYPOINT ["omcgo-worker"]
CMD ["--config", "/etc/omcgo/worker.yaml"]
