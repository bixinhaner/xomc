FROM node:20-alpine AS builder
WORKDIR /app
COPY omcmb/webcode/package.json omcmb/webcode/package-lock.json ./
RUN npm ci
COPY omcmb/webcode/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY omcgo/deployments/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
