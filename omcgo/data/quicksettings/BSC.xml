<?xml version="1.0" encoding="UTF-8"?>
<!--
  BSC paramModel(GSM 2G) 快速设置 - 5 group 结构（按用户老系统截图重组）。

  设计：
    1. BTS Config       单实例 form - 接入/基础/小区 19 字段（含 NeighborListMode）
    2. Handover         单实例 form - 切换公共/算法1/算法2 共 21 字段
    3. 4G Neighbor      多实例 table - DeviceGSM.Bts.{i}.Neighbor4G.{i}.{leaf}
    4. 2G Neighbor      多实例 table - DeviceGSM.Bts.{i}.Neighbor2G.{i}.{leaf}
    5. Trx              多实例 table - DeviceGSM.Bts.{i}.Trx.{i}.{leaf}

  形态约定：
    - form group：仅 standardPath（完整含 {i}），不含 objectPath；前端按选中 BTS 实例
      把 {i} 替换为 btsInstance；schema 字典自动给出 range hint。
    - multi group：BLQ 经典写法 objectPath 含两层 {i}（外=BTS，内=子实例行号），
      param 只填 leaf；MultiInstanceTable 自动行级增删 + 列内单元格保存。

  顶部 BTS 实例选择器复用 BLQ 机制，已支持 ＋/✖ 增删 DeviceGSM.Bts.{i}.。
-->
<quickSettings paramModel="BSC">

  <!-- ============ 1. BTS Config 大表单（19 字段，3 列布局自动） ============ -->
  <group id="bsc-bts-config" titleZh="BTS 配置" titleEn="BTS Config">
    <param name="ID" titleZh="BTS ID" titleEn="ID"
           standardPath="DeviceGSM.Bts.{i}.ID" readonly="true"/>
    <!-- BSC 设备约定: osmo-bsc 把 NumofTrxChannel / OmlConnectState 这两个 BSC 全局只读状态量
         暴露在 DeviceGSM.Bts.0 实例(固定索引 0)上，所有 BTS 实例共享同一份值。
         standardPath 固定写 Bts.0，applyInstanceContext 对不含 {i} 的 path 原样返回，
         所有 BTS 行都会读到同一根 leaf —— 满足"所有 BTS 显示这两个共享值"的需求。 -->
    <param name="NumofTrxChannel" titleZh="TRX 信道数" titleEn="NumofTrxChannel"
           standardPath="DeviceGSM.Bts.0.NumofTrxChannel" readonly="true"/>
    <param name="OmlConnectState" titleZh="OML 连接状态" titleEn="OmlConnectState"
           standardPath="DeviceGSM.Bts.0.OmlConnectState" readonly="true"/>

    <param name="LocationAreaCode" titleZh="位置区码 (LAC)" titleEn="LocationAreaCode"
           standardPath="DeviceGSM.Bts.{i}.LocationAreaCode"/>
    <param name="Bsic" titleZh="基站识别码 (BSIC)" titleEn="Bsic"
           standardPath="DeviceGSM.Bts.{i}.Bsic"/>
    <param name="IpaUnitId" titleZh="IPA 单元 ID" titleEn="IpaUnitId"
           standardPath="DeviceGSM.Bts.{i}.IpaUnitId"/>

    <param name="IpaRslIp" titleZh="IPA RSL IP" titleEn="IpaRslIp"
           standardPath="DeviceGSM.Bts.{i}.IpaRslIp"/>
    <param name="OmlIpaStreamId" titleZh="OML IPA 流 ID" titleEn="OmlIpaStreamId"
           standardPath="DeviceGSM.Bts.{i}.OmlIpaStreamId"/>
    <param name="Band" titleZh="频段" titleEn="Band"
           standardPath="DeviceGSM.Bts.{i}.Band" readonly="true"/>

    <param name="CellId" titleZh="小区 ID" titleEn="CellId"
           standardPath="DeviceGSM.Bts.{i}.CellId"/>
    <param name="MsMaxPower" titleZh="终端最大功率" titleEn="MsMaxPower"
           standardPath="DeviceGSM.Bts.{i}.MsMaxPower"/>
    <param name="GprsMode" titleZh="GPRS 模式" titleEn="GprsMode"
           standardPath="DeviceGSM.Bts.{i}.GprsMode" type="enum">
      <option value="egprs"/>
      <option value="gprs"/>
      <option value="none"/>
    </param>

    <param name="C0PowerRed" titleZh="C0 功率衰减" titleEn="C0PowerRed"
           standardPath="DeviceGSM.Bts.{i}.C0PowerRed" type="enum">
      <option value="0"/><option value="1"/><option value="2"/><option value="3"/><option value="4"/>
      <option value="5"/><option value="6"/><option value="7"/><option value="8"/><option value="9"/><option value="10"/>
    </param>
    <param name="NeighborListMode" titleZh="邻区列表模式" titleEn="NeighborListMode"
           standardPath="DeviceGSM.Bts.{i}.NeighborListMode" type="enum">
      <option value="automatic"/>
      <option value="manual"/>
    </param>
    <param name="CellReselectOffset" titleZh="小区重选偏移" titleEn="CellReselectOffset"
           standardPath="DeviceGSM.Bts.{i}.CellReselectOffset" type="enum">
      <option value="0"/><option value="1"/><option value="2"/><option value="3"/>
      <option value="4"/><option value="5"/><option value="6"/><option value="7"/>
    </param>

    <param name="CellReselectPenaltyTime" titleZh="小区重选惩罚时间" titleEn="CellReselectPenaltyTime"
           standardPath="DeviceGSM.Bts.{i}.CellReselectPenaltyTime" type="enum">
      <option value="0"/><option value="10"/><option value="20"/><option value="30"/><option value="40"/>
      <option value="50"/><option value="60"/><option value="70"/><option value="80"/><option value="90"/>
      <option value="100"/><option value="110"/><option value="120"/><option value="130"/><option value="140"/>
      <option value="150"/><option value="160"/><option value="170"/><option value="180"/><option value="190"/>
      <option value="200"/><option value="210"/><option value="220"/><option value="230"/><option value="240"/>
      <option value="250"/><option value="260"/><option value="270"/><option value="280"/><option value="290"/>
      <option value="300"/><option value="310"/>
    </param>
    <param name="CellReselectHysteresis" titleZh="小区重选迟滞" titleEn="CellReselectHysteresis"
           standardPath="DeviceGSM.Bts.{i}.CellReselectHysteresis" type="enum">
      <option value="0"/><option value="1"/><option value="2"/><option value="3"/>
      <option value="4"/><option value="5"/><option value="6"/><option value="7"/>
    </param>
    <param name="RachCellBarred" titleZh="RACH 小区禁入" titleEn="RachCellBarred"
           standardPath="DeviceGSM.Bts.{i}.RachCellBarred" type="enum">
      <option value="0"/>
      <option value="1"/>
    </param>

    <param name="CodecSupport" titleZh="编解码支持" titleEn="CodecSupport"
           standardPath="DeviceGSM.Bts.{i}.CodecSupport"
           type="multiCheckbox" checkboxOptions="fr,hr,efr,amr"/>
  </group>

  <!-- ============ 2. Handover 大表单（21 字段，含 handover+算法1+算法2） ============ -->
  <group id="bsc-bts-handover" titleZh="切换配置" titleEn="Handover">
    <param name="handover" titleZh="切换开关" titleEn="handover"
           standardPath="DeviceGSM.Bts.{i}.handover" type="enum">
      <option value="Allow"/>
      <option value="Forbid"/>
    </param>
    <param name="HandoverAlgorithm" titleZh="切换算法版本" titleEn="HandoverAlgorithm"
           standardPath="DeviceGSM.Bts.{i}.HandoverAlgorithm" type="enum">
      <option value="1"/>
      <option value="2"/>
    </param>
    <param name="handover1.maximum.distance" titleZh="算法1 最大距离" titleEn="handover1.maximum.distance"
           standardPath="DeviceGSM.Bts.{i}.handover1.maximum.distance"/>

    <param name="handover1.power.budget.hysteresis" titleZh="算法1 功率预算迟滞" titleEn="handover1.power.budget.hysteresis"
           standardPath="DeviceGSM.Bts.{i}.handover1.power.budget.hysteresis"/>
    <param name="handover1.power.budget.interval" titleZh="算法1 功率预算评估间隔" titleEn="handover1.power.budget.interval"
           standardPath="DeviceGSM.Bts.{i}.handover1.power.budget.interval"/>
    <param name="handover1.window.rxlev.averaging" titleZh="算法1 RXLEV 平均窗" titleEn="handover1.window.rxlev.averaging" type="enum"
           standardPath="DeviceGSM.Bts.{i}.handover1.window.rxlev.averaging">
      <option value="1"/><option value="2"/><option value="3"/><option value="4"/>
      <option value="5"/><option value="6"/><option value="7"/><option value="8"/>
      <option value="9"/><option value="10"/><option value="11"/><option value="12"/>
      <option value="13"/><option value="14"/><option value="15"/><option value="16"/>
    </param>

    <param name="handover1.window.rxlev.neighbor.averaging" titleZh="算法1 邻区 RXLEV 平均窗" titleEn="handover1.window.rxlev.neighbor.averaging" type="enum"
           standardPath="DeviceGSM.Bts.{i}.handover1.window.rxlev.neighbor.averaging">
      <option value="1"/><option value="2"/><option value="3"/><option value="4"/>
      <option value="5"/><option value="6"/><option value="7"/><option value="8"/>
      <option value="9"/><option value="10"/><option value="11"/><option value="12"/>
      <option value="13"/><option value="14"/><option value="15"/><option value="16"/>
    </param>
    <param name="handover1.window.rxqual.averaging" titleZh="算法1 RXQUAL 平均窗" titleEn="handover1.window.rxqual.averaging" type="enum"
           standardPath="DeviceGSM.Bts.{i}.handover1.window.rxqual.averaging">
      <option value="1"/><option value="2"/><option value="3"/><option value="4"/>
      <option value="5"/><option value="6"/><option value="7"/><option value="8"/>
      <option value="9"/><option value="10"/><option value="11"/><option value="12"/>
      <option value="13"/><option value="14"/><option value="15"/><option value="16"/>
    </param>
    <param name="handover2.afs-bias.rxlev" titleZh="算法2 AFS RXLEV 偏置" titleEn="handover2.afs-bias.rxlev" type="enum"
           standardPath="DeviceGSM.Bts.{i}.handover2.afs-bias.rxlev">
      <option value="0"/><option value="1"/><option value="2"/><option value="3"/>
      <option value="4"/><option value="5"/><option value="6"/><option value="7"/>
    </param>

    <param name="handover2.afs-bias.rxqual" titleZh="算法2 AFS RXQUAL 偏置" titleEn="handover2.afs-bias.rxqual" type="enum"
           standardPath="DeviceGSM.Bts.{i}.handover2.afs-bias.rxqual">
      <option value="0"/><option value="1"/><option value="2"/><option value="3"/>
      <option value="4"/><option value="5"/><option value="6"/><option value="7"/>
    </param>
    <param name="handover2_assignment" titleZh="算法2 指配触发" titleEn="handover2_assignment" type="enum"
           standardPath="DeviceGSM.Bts.{i}.handover2_assignment">
      <option value="0"/>
      <option value="1"/>
    </param>
    <param name="handover2.max-handovers" titleZh="算法2 最大切换数" titleEn="handover2.max-handovers"
           standardPath="DeviceGSM.Bts.{i}.handover2.max-handovers"/>

    <param name="handover2.maximum.distance" titleZh="算法2 最大距离" titleEn="handover2.maximum.distance"
           standardPath="DeviceGSM.Bts.{i}.handover2.maximum.distance"/>
    <param name="handover2.min.rxlev" titleZh="算法2 最低 RXLEV" titleEn="handover2.min.rxlev"
           standardPath="DeviceGSM.Bts.{i}.handover2.min.rxlev"/>
    <param name="handover2.min.rxqual" titleZh="算法2 最低 RXQUAL" titleEn="handover2.min.rxqual" type="enum"
           standardPath="DeviceGSM.Bts.{i}.handover2.min.rxqual">
      <option value="0"/><option value="1"/><option value="2"/><option value="3"/>
      <option value="4"/><option value="5"/><option value="6"/><option value="7"/>
    </param>

    <param name="handover2.min-free-slots.tch-f" titleZh="算法2 TCH/F 最少空闲时隙" titleEn="handover2.min-free-slots.tch-f"
           standardPath="DeviceGSM.Bts.{i}.handover2.min-free-slots.tch-f"/>
    <param name="handover2.min-free-slots.tch-h" titleZh="算法2 TCH/H 最少空闲时隙" titleEn="handover2.min-free-slots.tch-h"
           standardPath="DeviceGSM.Bts.{i}.handover2.min-free-slots.tch-h"/>
    <param name="handover2.penalty-time.failed-assignment" titleZh="算法2 指配失败惩罚时间" titleEn="handover2.penalty-time.failed-assignment"
           standardPath="DeviceGSM.Bts.{i}.handover2.penalty-time.failed-assignment"/>

    <param name="handover2.penalty-time.failed-ho" titleZh="算法2 切换失败惩罚时间" titleEn="handover2.penalty-time.failed-ho"
           standardPath="DeviceGSM.Bts.{i}.handover2.penalty-time.failed-ho"/>
    <param name="handover2.penalty-time.low-rxqual-assignment" titleZh="算法2 低 RXQUAL 指配惩罚" titleEn="handover2.penalty-time.low-rxqual-assignment"
           standardPath="DeviceGSM.Bts.{i}.handover2.penalty-time.low-rxqual-assignment"/>
    <param name="handover2.penalty-time.low-rxqual-ho" titleZh="算法2 低 RXQUAL 切换惩罚" titleEn="handover2.penalty-time.low-rxqual-ho"
           standardPath="DeviceGSM.Bts.{i}.handover2.penalty-time.low-rxqual-ho"/>
  </group>

  <!-- ============ 3. 4G Neighbor 多实例表（每 BTS 下 N 条 4G 邻区） ============ -->
  <group id="bsc-bts-neighbor4g" titleZh="4G 邻区" titleEn="4G Neighbor"
         multiInstance="true" maxInstances="32"
         objectPath="DeviceGSM.Bts.{i}.Neighbor4G.{i}.">
    <param name="earfcn"    titleZh="EARFCN"    titleEn="earfcn"    leaf="earfcn"/>
    <param name="thresh-hi" titleZh="高门限"     titleEn="thresh-hi" leaf="thresh-hi"/>
    <param name="thresh-lo" titleZh="低门限"     titleEn="thresh-lo" leaf="thresh-lo"/>
    <param name="prio"      titleZh="优先级"     titleEn="prio"      leaf="prio"/>
    <param name="qrxlv"     titleZh="QRxLev 门限" titleEn="qrxlv"    leaf="qrxlv"/>
    <param name="meas"      titleZh="测量带宽"   titleEn="meas"      leaf="meas"/>
  </group>

  <!-- ============ 4. 2G Neighbor 多实例表（每 BTS 下 N 条 2G 邻区） ============ -->
  <group id="bsc-bts-neighbor2g" titleZh="2G 邻区" titleEn="2G Neighbor"
         multiInstance="true" maxInstances="64"
         objectPath="DeviceGSM.Bts.{i}.Neighbor2G.{i}.">
    <param name="mcc"   titleZh="MCC"   titleEn="mcc"   leaf="mcc"/>
    <param name="mnc"   titleZh="MNC"   titleEn="mnc"   leaf="mnc"/>
    <param name="lac"   titleZh="LAC"   titleEn="lac"   leaf="lac"/>
    <param name="ci"    titleZh="CI"    titleEn="ci"    leaf="ci"/>
    <param name="arfcn" titleZh="ARFCN" titleEn="arfcn" leaf="arfcn"/>
    <param name="bsic"  titleZh="BSIC"  titleEn="bsic"  leaf="bsic"/>
  </group>

  <!-- ============ 5. Trx 多实例表（每 BTS 下 N 个 TRX） ============ -->
  <group id="bsc-bts-trx" titleZh="TRX 收发信机" titleEn="Trx"
         multiInstance="true" maxInstances="8"
         objectPath="DeviceGSM.Bts.{i}.Trx.{i}.">
    <param name="Arfcn"       titleZh="ARFCN"        titleEn="Arfcn"       leaf="Arfcn"/>
    <param name="RfLocked"    titleZh="RF 锁定"      titleEn="RfLocked"    leaf="RfLocked"/>
    <param name="MaxPowerRed" titleZh="最大功率衰减" titleEn="MaxPowerRed" leaf="MaxPowerRed"/>
  </group>

</quickSettings>
