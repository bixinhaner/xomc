              <param name="Option60" titleZh="Option60" titleEn="Option60" standardPath="Device.DeviceInfo.WAN_CONFIG4_OPTION60" type="string" maxValue="64"/>
       </group>
       <group id="device-static-route-1" titleZh="静态路由 1" titleEn="Static Routing 1">
              <param name="Enable" titleZh="是否生效" titleEn="Enabled" standardPath="Device.DeviceInfo.ROUTE_CONFIG1_ONBOOTENB">
                     <option value="1" label="ON"/>
