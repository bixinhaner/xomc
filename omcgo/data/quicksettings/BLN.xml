              <param name="Gateway" titleZh="网关" titleEn="Gateway" standardPath="Device.DeviceInfo.WAN_CONFIG2_DEFAULTGW"/>
              <param name="VLAN" titleZh="VLAN ID" titleEn="VLAN ID" standardPath="Device.DeviceInfo.WAN_CONFIG2_VLAN" type="unsignedInt" minValue="0" maxValue="4094"/>
              <param name="Option60" titleZh="Option60" titleEn="Option60" standardPath="Device.DeviceInfo.WAN_CONFIG2_OPTION60" type="string" maxValue="64"/>
       </group>
       <group id="device-wan-3" titleZh="WAN 配置 3" titleEn="WAN Config 3">
              <param name="Enable" titleZh="是否生效" titleEn="Enabled" standardPath="Device.DeviceInfo.WAN_CONFIG3_ENABLE">
                     <option value="1" label="ON"/>
                     <option value="0" label="OFF"/>
              </param>
              <param name="IPMode" titleZh="IP 接入模式" titleEn="IP Access Mode" standardPath="Device.DeviceInfo.WAN_CONFIG3_IPMODE">
                     <option value="0" label="DHCP"/>
                     <option value="1" label="Static IP"/>
              </param>
              <param name="IPAddress" titleZh="IP 地址" titleEn="IP Address" standardPath="Device.DeviceInfo.WAN_CONFIG3_IPADDR"/>
