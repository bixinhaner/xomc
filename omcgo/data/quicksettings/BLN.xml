              <param name="Gateway" titleZh="隧道网关" titleEn="Tunnel Gateway" standardPath="Device.DeviceInfo.ROUTE_CONFIG3_GW"/>
       </group>
       <group id="device-static-route-4" titleZh="静态路由 4" titleEn="Static Routing 4">
              <param name="Enable" titleZh="是否生效" titleEn="Enabled" standardPath="Device.DeviceInfo.ROUTE_CONFIG4_ONBOOTENB">
                     <option value="1" label="ON"/>
