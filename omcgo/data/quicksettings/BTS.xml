<?xml version="1.0" encoding="UTF-8"?>
<!--
  BTS paramModel 快速设置（GSM）。
  布局对照参考截图（友机 OMC 风格 3 列布局）：
    [基站信息]          LAC | ARFCN | Frequency(MHz, 派生)
    [GSM 传输参数]      ipa Port | Unit ID | Remote IP
                       Remote IP Backup | Power Modify | Abis Link Interface Binding
  字段 ← 标准路径映射:
    LAC                ← Device.DeviceInfo.BTS.CurrentLac
    ARFCN              ← Device.DeviceInfo.BTS.CurrentArfcn
    Frequency          ← 前端按 ARFCN 派生（CellParameterForm.FrequencyDisplay）
    Unit ID            ← DeviceGSM.IpaUnitId
    Remote IP          ← DeviceGSM.OmlRemoteIp
    Remote IP Backup   ← DeviceGSM.OmlRemoteIpBak
    Power Modify       ← Device.DeviceInfo.GSM.BtsRfPower (U_INT, 24..43 dBm)
    WAN IP             ← Device.DeviceInfo.WAN_CONFIG1_IPADDR
  TODO（缺标准映射，待后端确认 standardPath 后补）:
    ipa Port                       (截图示例值 9227, 范围 0..65534)
    Abis Link Interface Binding    (截图示例值 eth2, 下拉枚举)
-->
<quickSettings paramModel="BTS">
  <group id="bts-cell-info" titleZh="基站信息" titleEn="Cell Info">
    <param name="CurrentLac" titleZh="Location Area Code" titleEn="Location Area Code"
           standardPath="Device.DeviceInfo.BTS.CurrentLac"/>
    <param name="CurrentArfcn" titleZh="ARFCN" titleEn="ARFCN"
           standardPath="Device.DeviceInfo.BTS.CurrentArfcn"/>
    <!-- Frequency(MHz) 由前端按 CurrentArfcn 派生显示，参见 CellParameterForm.FrequencyDisplay -->
  </group>

  <group id="gsm-transport" titleZh="GSM 传输参数" titleEn="GSM Transport Settings">
    <param name="UnitID" titleZh="Unit ID" titleEn="Unit ID"
           standardPath="DeviceGSM.IpaUnitId"/>
    <param name="RemoteIP" titleZh="Remote IP" titleEn="Remote IP"
           standardPath="DeviceGSM.OmlRemoteIp"/>
    <param name="RemoteIPBak" titleZh="Remote IP 备份" titleEn="Remote IP Backup"
           standardPath="DeviceGSM.OmlRemoteIpBak"/>
    <param name="BtsRfPower" titleZh="Power Modify" titleEn="Power Modify"
           standardPath="Device.DeviceInfo.GSM.BtsRfPower" unit="dBm"/>
    <param name="WanIP" titleZh="WAN IP" titleEn="WAN IP"
           standardPath="Device.DeviceInfo.WAN_CONFIG1_IPADDR"/>
  </group>
</quickSettings>