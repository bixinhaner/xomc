<?xml version="1.0" encoding="UTF-8"?>
<!--
  BaiBNQ paramModel(BAICELLS 5G NR / gNB)的快速设置。
  约定:
    - 所有 standardPath 与 BaiBNQ.xml 字典 1:1 对应(已 grep 核对)。
    - 部分字段 standardPath 含 `FAPService.1`(写死实例号),那是字典里专门为该字段提供的精确版本;
      与设计 §2.2.1 GNB FAPService 固定 1 的约定一致。
-->
<quickSettings paramModel="BaiBNQ">
  <group id="gnb-cell" titleZh="小区参数" titleEn="Cell Parameters">
    <param name="Band" titleZh="频段" titleEn="Band"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.FrequencyInfoDLSIB.MultiFrequencyBandListNRSIB.{i}.FreqBandIndicatorNR"
           hideRangeHint="true"/>
    <param name="SsbFrequency" titleZh="SSB 频点" titleEn="SSB Frequency"
           standardPath="Device.Services.FAPService.1.CellConfig.{i}.NR.RAN.RF.SsbFrequency"/>
    <param name="DLSubCarrierSpacing" titleZh="下行子载波间隔" titleEn="DL SubCarrier Spacing" type="enum"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.FrequencyInfoDLSIB.ScsSpecificCarrierList.{i}.SCSSpecificCarrier.SubcarrierSpacing">
      <option value="0" label="15kHz"/>
      <option value="1" label="30kHz"/>
      <option value="2" label="60kHz"/>
    </param>
    <param name="ULSubCarrierSpacing" titleZh="上行子载波间隔" titleEn="UL SubCarrier Spacing" type="enum"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.FrequencyInfoULSIB.ScsSpecificCarrierList.{i}.SCSSpecificCarrier.SubcarrierSpacing">
      <option value="0" label="15kHz"/>
      <option value="1" label="30kHz"/>
      <option value="2" label="60kHz"/>
    </param>
    <param name="DLCarrierBandWidth" titleZh="下行载波带宽" titleEn="DL Carrier Bandwidth"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.FrequencyInfoDLSIB.ScsSpecificCarrierList.{i}.SCSSpecificCarrier.CarrierBandwidth"/>
    <param name="ULCarrierBandWidth" titleZh="上行载波带宽" titleEn="UL Carrier Bandwidth"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.FrequencyInfoULSIB.ScsSpecificCarrierList.{i}.SCSSpecificCarrier.CarrierBandwidth"/>
    <param name="NRARFCNDL" titleZh="NR 下行频点" titleEn="NRARFCNDL"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.RF.NRARFCNDL"/>
    <param name="NRARFCNUL" titleZh="NR 上行频点" titleEn="NRARFCNUL"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.RF.NRARFCNUL"/>
    <param name="NumOfRxAntenna" titleZh="接收天线数" titleEn="Num Of Rx Antenna"
           standardPath="Device.Services.FAPService.1.CellConfig.{i}.NR.RAN.PHY.Antenna.NumOfRxAntenna"/>
    <param name="NumOfTxAntenna" titleZh="发射天线数" titleEn="Num Of Tx Antenna"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.Antenna.NumOfTxAntenna"/>
    <param name="OffsetToPointA" titleZh="OffsetToPointA" titleEn="Offset To Point A"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.FrequencyInfoDLSIB.OffsetToPointA"/>
    <param name="PCI" titleZh="PCI" titleEn="PCI"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.RF.PhyCellID"/>
    <param name="PowerModify" titleZh="功率等级" titleEn="Power Level"
           standardPath="Device.Services.FAPService.1.CellConfig.{i}.NR.RAN.PowerModify"
           extraInfoPath="Device.DeviceInfo.SupportedPowerRange" unit="dBm"/>
    <param name="RFEnable" titleZh="射频启用" titleEn="RF Enable"
           standardPath="Device.Services.FAPService.1.CellConfig.1.NR.RAN.rftxEnable" type="enum">
      <option value="1" label="ON"/>
      <option value="0" label="OFF"/>
    </param>
    <param name="SsbSubcarrierOffset" titleZh="SSB 子载波偏移" titleEn="SSB Subcarrier Offset"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.SSB.SsbSubcarrierOffset"/>
  </group>
  <group id="gnb-core" titleZh="核心网参数" titleEn="Core Network Parameters">
    <param name="PLMNID" titleZh="PLMN" titleEn="PLMN"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.CN.TA.{i}.PLMNList.{i}.PLMNID"/>
    <param name="TAC" titleZh="TAC" titleEn="TAC"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.CN.TA.{i}.TAC"/>
    <param name="AmfIP1" titleZh="AMF IP" titleEn="AMF IP"
           standardPath="Device.Services.FAPService.{i}.FAPControl.NR.AMFPoolConfigParam.{i}.AmfIP1"/>
    <param name="gNBName" titleZh="gNB Name" titleEn="gNB Name"
           standardPath="Device.Services.FAPService.1.FAPControl.NR.RAN.Common.gNBName"/>
    <param name="NguBindInterface" titleZh="NGU 本地地址" titleEn="NGU Local Address"
           standardPath="Device.FAP.NguIpBind{i}.BindInterface"/>
    <param name="gNBId" titleZh="gNB ID" titleEn="gNB ID"
           standardPath="Device.Services.FAPService.{i}.FAPControl.NR.RAN.Common.gNBId"/>
    <param name="gNBIdLength" titleZh="gNB Length" titleEn="gNB ID Length" type="unsignedInt"
           standardPath="Device.Services.FAPService.{i}.FAPControl.NR.RAN.Common.gNBIdLength"/>
    <param name="NrcellIdentity" titleZh="NCI" titleEn="NCI"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.CN.TA.{i}.NrcellIdentity"/>
  </group>
  <group id="gnb-tdd" titleZh="TDD 配置" titleEn="TDD Configuration">
    <param name="ReferenceSubcarrierSpacing" titleZh="参考子载波间隔" titleEn="Reference Subcarrier Spacing"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.ReferenceSubcarrierSpacing"/>
    <param name="DlULTransmissionPeriodicity" titleZh="Pattern1 时隙周期" titleEn="Pattern1 Periodicity"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern1.DlULTransmissionPeriodicity"/>
    <param name="NrofDownlinkSlots" titleZh="Pattern1 下行时隙数" titleEn="Pattern1 DL Slots"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern1.NrofDownlinkSlots"/>
    <param name="NrofDownlinkSymbols" titleZh="Pattern1 下行特殊符号数" titleEn="Pattern1 DL Symbols"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern1.NrofDownlinkSymbols"/>
    <param name="NrofUplinkSlots" titleZh="Pattern1 上行时隙数" titleEn="Pattern1 UL Slots"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern1.NrofUplinkSlots"/>
    <param name="NrofUplinkSymbols" titleZh="Pattern1 上行特殊符号数" titleEn="Pattern1 UL Symbols"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern1.NrofUplinkSymbols"/>
    <param name="Pat2DlULTransmissionPeriodicity" titleZh="Pattern2 时隙周期" titleEn="Pattern2 Periodicity"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern2.DlULTransmissionPeriodicity"/>
    <param name="Pat2NrofDownlinkSlots" titleZh="Pattern2 下行时隙数" titleEn="Pattern2 DL Slots"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern2.NrofDownlinkSlots"/>
    <param name="Pat2NrofDownlinkSymbols" titleZh="Pattern2 下行特殊符号数" titleEn="Pattern2 DL Symbols"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern2.NrofDownlinkSymbols"/>
    <param name="Pat2NrofUplinkSlots" titleZh="Pattern2 上行时隙数" titleEn="Pattern2 UL Slots"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern2.NrofUplinkSlots"/>
    <param name="Pat2NrofUplinkSymbols" titleZh="Pattern2 上行特殊符号数" titleEn="Pattern2 UL Symbols"
           standardPath="Device.Services.FAPService.{i}.CellConfig.{i}.NR.RAN.PHY.TddULDLConfigurationCommon.pattern2.NrofUplinkSymbols"/>
  </group>
  <group id="device-time" titleZh="NTP" titleEn="NTP">
        <param name="Enable" titleZh="NTP 模式" titleEn="NTP Mode"
                       standardPath="Device.Time.Enable">
                <option value="1" label="NTP Client"/>
                <option value="0" label="NTP Server"/>
        </param>
    <param name="LocalTimeZoneName" titleZh="本地时区" titleEn="Local Time Zone"
           standardPath="Device.Time.LocalTimeZoneName"/>
    <param name="NTPServer1" titleZh="NTP 服务器 1" titleEn="NTP Server 1"
           standardPath="Device.Time.NTPServer1"/>
    <param name="NTPServer2" titleZh="NTP 服务器 2" titleEn="NTP Server 2"
           standardPath="Device.Time.NTPServer2"/>
    <param name="NTPServer3" titleZh="NTP 服务器 3" titleEn="NTP Server 3"
           standardPath="Device.Time.NTPServer3"/>
    <param name="NTPServer4" titleZh="NTP 服务器 4" titleEn="NTP Server 4"
           standardPath="Device.Time.NTPServer4"/>
    <param name="NTPServer5" titleZh="NTP 服务器 5" titleEn="NTP Server 5"
           standardPath="Device.Time.NTPServer5"/>
  </group>

  <group id="gnb-sync-source" titleZh="同步源设置" titleEn="Sync Source Settings">
    <param name="PpsTimeMode" titleZh="模式" titleEn="Mode" type="string"
           standardPath="Device.FAP.Synchronization.PpsTimeMode">
      <option value="FREE_OSCILLATION" label="FREE_OSCILLATION"/>
      <option value="GPS_PPS" label="GPS_PPS"/>
      <option value="LOCAL_CLOCK_HOLDOVER_GPS_PPS" label="LOCAL_CLOCK_HOLDOVER_GPS_PPS"/>
      <option value="OCXO_PPS" label="OCXO_PPS"/>
      <option value="1588_PPS" label="1588_PPS"/>
      <option value="GPS_AND_PTP" label="GPS_AND_PTP"/>
    </param>
    <param name="SyncSource" titleZh="同步源" titleEn="Sync Source" type="string"
           standardPath="Device.FAP.GPS.SyncSource">
      <option value="GPS" label="GPS"/>
      <option value="GLONASS" label="GLONASS"/>
      <option value="BEIDOU" label="BEIDOU"/>
      <option value="GALILEO" label="GALILEO"/>
      <option value="QZSS" label="QZSS"/>
    </param>
    <param name="ForcedSync" titleZh="强制同步" titleEn="Forced Sync" type="unsignedInt"
           standardPath="Device.DeviceInfo.iForcedSyncControlSwitch" defaultValue="1" hideRangeHint="true">
      <option value="1" label="1"/>
      <option value="0" label="0"/>
    </param>
    <param name="PTPSyncStatus" titleZh="同步状态" titleEn="Sync Status" type="string" readonly="true"
           standardPath="Device.FAP.PTP1588.SyncStatus"/>
    <param name="PTPProfile" titleZh="协议类型" titleEn="Profile" type="string"
           standardPath="Device.FAP.PTP1588.Profile">
      <option value="1588v2" label="1588v2"/>
    </param>
    <param name="PTPDomain" titleZh="域号" titleEn="Domain" type="string"
           standardPath="Device.FAP.PTP1588.Domain"/>
    <param name="PTPTransmode" titleZh="传输模式" titleEn="Transmission Mode" type="string"
           standardPath="Device.FAP.PTP1588.Transmode">
      <option value="L2" label="L2"/>
      <option value="L3" label="L3"/>
    </param>
    <param name="PTPInterface" titleZh="接口" titleEn="Interface" type="string"
           standardPath="Device.FAP.PTP1588.Interface">
      <option value="eth-WAN" label="eth-WAN"/>
      <option value="eth0" label="eth0"/>
      <option value="eth1" label="eth1"/>
    </param>
    <param name="PTPUnicastMode" titleZh="单播使能" titleEn="Unicast Mode" type="string"
           standardPath="Device.FAP.PTP1588.UnicastMode">
      <option value="0" label="组播"/>
      <option value="1" label="单播"/>
    </param>
    <param name="PTPSyncInterval" titleZh="同步请求间隔" titleEn="Sync Interval" type="string"
           standardPath="Device.FAP.PTP1588.SyncInterval">
      <option value="-7" label="-7"/>
      <option value="-6" label="-6"/>
      <option value="-5" label="-5"/>
      <option value="-4" label="-4"/>
      <option value="-3" label="-3"/>
      <option value="-2" label="-2"/>
      <option value="-1" label="-1"/>
      <option value="0" label="0"/>
    </param>
    <param name="PTPDelayInterval" titleZh="时延请求间隔" titleEn="Delay Interval" type="string"
           standardPath="Device.FAP.PTP1588.DelayInterval">
      <option value="-7" label="-7"/>
      <option value="-6" label="-6"/>
      <option value="-5" label="-5"/>
      <option value="-4" label="-4"/>
      <option value="-3" label="-3"/>
      <option value="-2" label="-2"/>
      <option value="-1" label="-1"/>
      <option value="0" label="0"/>
    </param>
  </group>

  <!-- 5G 网络设置：来自旧 OMC 的 WAN(VLAN)/LAN、Default Route、DSCP、Static Routing。
       IPSEC 已由下方既有分组承载，这里不重复定义。 -->
  <group id="gnb-network-interface" titleZh="WAN(VLAN)/LAN" titleEn="WAN(VLAN)/LAN"
         multiInstance="true" style="table" maxInstances="16"
         objectPath="Device.Ethernet.Interface.{i}.">
    <param name="Status" titleZh="状态" titleEn="Status" leaf="Status" readonly="true"/>
    <param name="InterfaceType" titleZh="接口类型" titleEn="Interface Type" leaf="interfaceType"/>
  </group>
  <group id="gnb-interface-ipv4" titleZh="接口直连 IPv4" titleEn="Direct Interface IPv4"
         multiInstance="true" style="subtable" parentSelector="gnb-network-interface" maxInstances="8"
         objectPath="Device.Ethernet.Interface.{i}.IPv4Address.{i}.">
    <param name="AddressingType" titleZh="IP 类型" titleEn="IP Type" leaf="AddressingType" type="enum">
      <option value="DHCP" label="DHCP"/>
      <option value="Static" label="Static"/>
    </param>
    <param name="IPAddress" titleZh="IP 地址" titleEn="IP Address" leaf="IPAddress"/>
    <param name="SubnetMask" titleZh="子网掩码" titleEn="Subnet Mask" leaf="SubnetMask"/>
    <param name="DefaultGateway" titleZh="网关" titleEn="Gateway" leaf="DefaultGateway"/>
    <param name="PortType" titleZh="端口类型" titleEn="Port Type" leaf="PortType" type="enum">
      <option value="NG" label="NG"/><option value="OAM" label="OAM"/><option value="NGU" label="NGU"/>
      <option value="NG/OAM" label="NG/OAM"/><option value="NG/NGU" label="NG/NGU"/><option value="OAM/NGU" label="OAM/NGU"/>
      <option value="NG/OAM/NGU" label="NG/OAM/NGU"/><option value="Other" label="Other"/>
    </param>
  </group>
  <group id="gnb-interface-ipv6" titleZh="IPv6 地址" titleEn="IPv6 Address"
         multiInstance="true" style="subtable" parentSelector="gnb-network-interface" maxInstances="8"
         objectPath="Device.Ethernet.Interface.{i}.IPv6Address.{i}.">
    <param name="Origin" titleZh="IP 类型" titleEn="IP Type" leaf="Origin" type="enum">
      <option value="DHCPv6" label="DHCPv6"/><option value="Static" label="Static"/>
    </param>
    <param name="IPAddress" titleZh="IP 地址" titleEn="IP Address" leaf="IPAddress"/>
    <param name="PrefixLength" titleZh="前缀长度" titleEn="Prefix Length" leaf="PrefixLength"/>
    <param name="DefaultGateway" titleZh="网关" titleEn="Gateway" leaf="DefaultGateway"/>
    <param name="PortType" titleZh="端口类型" titleEn="Port Type" leaf="PortType" type="enum">
      <option value="NG" label="NG"/><option value="OAM" label="OAM"/><option value="NGU" label="NGU"/>
      <option value="NG/OAM" label="NG/OAM"/><option value="NG/NGU" label="NG/NGU"/><option value="OAM/NGU" label="OAM/NGU"/>
      <option value="NG/OAM/NGU" label="NG/OAM/NGU"/><option value="Other" label="Other"/>
    </param>
  </group>
  <group id="gnb-interface-vlan" titleZh="VLAN" titleEn="VLAN"
         multiInstance="true" style="subtable" parentSelector="gnb-network-interface" maxInstances="16"
         objectPath="Device.Ethernet.Interface.{i}.VlanInterface.{i}.">
    <param name="Name" titleZh="VLAN 名称" titleEn="VLAN Name" leaf="Name"/>
    <param name="Id" titleZh="VLAN ID" titleEn="VLAN ID" leaf="Id"/>
              <param name="Enable" titleZh="启用" titleEn="Enable" leaf="Enable" type="enum">
                     <option value="1" label="ON"/><option value="0" label="OFF"/>
    </param>
  </group>
       <group id="gnb-interface-vlan-ipv4" titleZh="VLAN IPv4 地址" titleEn="VLAN IPv4 Address"
                             multiInstance="true" style="subtable" parentSelector="gnb-interface-vlan" maxInstances="8"
                              objectPath="Device.Ethernet.Interface.{i}.VlanInterface.{i}.IPv4Address.{i}.">
              <param name="AddressingType" titleZh="IP 类型" titleEn="IP Type" leaf="AddressingType" type="enum">
                     <option value="DHCP" label="DHCP"/><option value="Static" label="Static"/>
              </param>
              <param name="IPAddress" titleZh="IP 地址" titleEn="IP Address" leaf="IPAddress"/>
              <param name="SubnetMask" titleZh="子网掩码" titleEn="Subnet Mask" leaf="SubnetMask"/>
              <param name="DefaultGateway" titleZh="网关" titleEn="Gateway" leaf="DefaultGateway"/>
              <param name="PortType" titleZh="端口类型" titleEn="Port Type" leaf="PortType" type="enum">
                     <option value="NG" label="NG"/><option value="OAM" label="OAM"/><option value="NGU" label="NGU"/>
                     <option value="NG/OAM" label="NG/OAM"/><option value="NG/NGU" label="NG/NGU"/><option value="OAM/NGU" label="OAM/NGU"/>
                     <option value="NG/OAM/NGU" label="NG/OAM/NGU"/><option value="Other" label="Other"/>
              </param>
       </group>
       <group id="gnb-interface-vlan-ipv6" titleZh="VLAN IPv6 地址" titleEn="VLAN IPv6 Address"
                             multiInstance="true" style="subtable" parentSelector="gnb-interface-vlan" maxInstances="8"
                              objectPath="Device.Ethernet.Interface.{i}.VlanInterface.{i}.IPv6Address.{i}.">
              <param name="Origin" titleZh="IP 类型" titleEn="IP Type" leaf="Origin" type="enum">
                     <option value="DHCPv6" label="DHCPv6"/><option value="Static" label="Static"/>
              </param>
              <param name="IPAddress" titleZh="IPv6 地址" titleEn="IPv6 Address" leaf="IPAddress"/>
              <param name="PrefixLength" titleZh="前缀长度" titleEn="Prefix Length" leaf="PrefixLength"/>
              <param name="DefaultGateway" titleZh="网关" titleEn="Gateway" leaf="DefaultGateway"/>
              <param name="PortType" titleZh="端口类型" titleEn="Port Type" leaf="PortType" type="enum">
                     <option value="NG" label="NG"/><option value="OAM" label="OAM"/><option value="NGU" label="NGU"/>
                     <option value="NG/OAM" label="NG/OAM"/><option value="NG/NGU" label="NG/NGU"/><option value="OAM/NGU" label="OAM/NGU"/>
                     <option value="NG/OAM/NGU" label="NG/OAM/NGU"/><option value="Other" label="Other"/>
              </param>
       </group>

  <group id="gnb-network-default-route" titleZh="默认路由" titleEn="Default Route">
    <param name="DefaultInterfaceName" titleZh="默认路由" titleEn="Default Route"
           standardPath="Device.Ethernet.DefaultIpRoute.DefaultInterfaceName"/>
    <param name="DnsType" titleZh="DNS 类型" titleEn="DNS Type"
           standardPath="Device.FAP.gNB.config.DnsType" type="enum">
      <option value="Static" label="Static"/>
      <option value="DHCP" label="DHCP"/>
    </param>
    <param name="Dns" titleZh="DNS" titleEn="DNS"
           standardPath="Device.FAP.gNB.config.dns" type="string"/>
  </group>

  <group id="gnb-network-dscp" titleZh="DSCP" titleEn="DSCP">
    <param name="NgapDscp" titleZh="NGAP DSCP" titleEn="NGAP DSCP" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.NgapDscp.Dscp"/>
    <param name="NgapVlanPrio" titleZh="NGAP VLAN 优先级" titleEn="NGAP VLAN Priority" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.NgapDscp.VlanPrio"/>
    <param name="X2apDscp" titleZh="X2AP DSCP" titleEn="X2AP DSCP" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.X2apDscp.Dscp"/>
    <param name="X2apVlanPrio" titleZh="X2AP VLAN 优先级" titleEn="X2AP VLAN Priority" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.X2apDscp.VlanPrio"/>
    <param name="F1apDscp" titleZh="F1AP DSCP" titleEn="F1AP DSCP" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.F1apDscp.Dscp"/>
    <param name="F1apVlanPrio" titleZh="F1AP VLAN 优先级" titleEn="F1AP VLAN Priority" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.F1apDscp.VlanPrio"/>
    <param name="XnapDscp" titleZh="XNAP DSCP" titleEn="XNAP DSCP" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.XnapDscp.Dscp"/>
    <param name="XnapVlanPrio" titleZh="XNAP VLAN 优先级" titleEn="XNAP VLAN Priority" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.XnapDscp.VlanPrio"/>
    <param name="OamDscp" titleZh="OAM DSCP" titleEn="OAM DSCP" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.OamDscp.Dscp"/>
    <param name="OamVlanPrio" titleZh="OAM VLAN 优先级" titleEn="OAM VLAN Priority" standardPath="Device.Services.FAPService.{i}.FAPControl.NR.OamDscp.VlanPrio"/>
  </group>
  <group id="gnb-network-dscp-list" titleZh="DSCP 映射列表" titleEn="DSCP Mapping List" multiInstance="true" maxInstances="16" objectPath="Device.Services.FAPService.{i}.FAPControl.NR.DscpList.{i}.">
    <param name="Dscp" titleZh="DSCP" titleEn="DSCP" leaf="Dscp"/>
    <param name="VlanPrio" titleZh="VLAN 优先级" titleEn="VLAN Priority" leaf="VlanPrio"/>
  </group>
  <group id="gnb-network-static-route" titleZh="静态路由" titleEn="Static Routing" multiInstance="true" maxInstances="32" objectPath="Device.Ethernet.IpRoute.{i}.">
    <param name="IpVer" titleZh="IP 版本" titleEn="IP Version" leaf="IpVer" type="enum" defaultValue="1">
      <option value="1" label="IPv4"/>
      <option value="2" label="IPv6"/>
    </param>
    <param name="InterfaceName" titleZh="接口名称" titleEn="Interface Name" leaf="InterfaceName" type="enum" defaultValue="opt">
