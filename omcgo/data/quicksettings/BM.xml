  <!--
    GSM 小区参数（BM 制式切换 GSM 时显示）。
    前端按 group.objectPath/standardPath 是否以 Device.Services.GsmBTSCellDT. 起始
    判定 GSM 分组，进而启用"制式: LTE/GSM"切换器（见 QuickSettingsTab/index.tsx）。
    字段对照截图 GSM Cell Settings 表：
      Cell Status   ← OpState           (READ_WRITE,   0=OFF / 1=ON)
      RF Power      ← GsmTxAntNum * GsmBtsRFPower (READ_WRITE,   max=43)
      Route Index   ← GsmCellWithRuRelation (READ_WRITE, display raw value)
      RF Status     ← RfState           (READ_ONLY,    max=2)
      UE Connections← UeCount           (READ_ONLY)
      Band          ← GsmBtsBand        (READ_ONLY)
      Cell ID       ← GsmCellID         (READ_ONLY,    max=65535)
      LAC           ← CurrLocAreaCode   (READ_ONLY,    max=65535)
      MNC           ← MobileNetworkCode (READ_ONLY,    max=8)
      MCC           ← NetworkCountryCode(READ_ONLY,    max=8)
      BSIC          ← GsmBSIC           (READ_ONLY,    max=65535)
      BSC Select    ← BscSelect         (READ_ONLY,    max=255)
      ARFCN         ← CurrentArfcn      (READ_ONLY,    max=65535)
      TRX 数量      ← GsmTxAntNum       (hidden, editable in RF Power prefix)
      RU Relation   ← GsmCellWithRuRelation (shown as Route Index)
    Abis Link Status 截图字段在 BM 字典中无对应 standardPath，先不暴露，后续若设备
    侧补齐 LinkState 等节点再追加。
  -->
  <group id="gsm-cell" titleZh="GSM 空口参数" titleEn="Air Interface Settings">
    <param name="OpState" titleZh="小区状态" titleEn="Cell Status"
           standardPath="Device.Services.GsmBTSCellDT.{i}.OpState"/>
    <param name="GsmBtsRFPower" titleZh="发射功率(dBm)" titleEn="Transmission Power(dBm)"
           standardPath="Device.Services.GsmBTSCellDT.{i}.GsmBtsRFPower"/>
    <param name="RfState" titleZh="RF 状态" titleEn="RF Status"
           standardPath="Device.Services.GsmBTSCellDT.{i}.RfState" readonly="true"/>
    <param name="UeCount" titleZh="UE 连接数" titleEn="UE Connections"
           standardPath="Device.Services.GsmBTSCellDT.{i}.UeCount" readonly="true"/>
    <param name="GsmBtsBand" titleZh="频段" titleEn="Band"
