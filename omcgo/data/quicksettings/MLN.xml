              <param name="VLAN" titleZh="VLAN ID" titleEn="VLAN ID" standardPath="Device.DeviceInfo.WAN_CONFIG3_VLAN" type="unsignedInt" minValue="0" maxValue="4094"/>
              <param name="Option60" titleZh="Option60" titleEn="Option60" standardPath="Device.DeviceInfo.WAN_CONFIG3_OPTION60" type="string" maxValue="64"/>
       </group>
       <group id="device-wan-4" titleZh="WAN 配置 4" titleEn="WAN Config 4">
              <param name="Enable" titleZh="是否生效" titleEn="Enabled" standardPath="Device.DeviceInfo.WAN_CONFIG4_ENABLE">
                     <option value="1" label="ON"/><option value="0" label="OFF"/>
              </param>
              <param name="IPMode" titleZh="IP 接入模式" titleEn="IP Access Mode" standardPath="Device.DeviceInfo.WAN_CONFIG4_IPMODE">
