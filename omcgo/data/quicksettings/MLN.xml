                     <option value="1" label="ON"/><option value="0" label="OFF"/>
              </param>
              <param name="DestinationNetwork" titleZh="目的网络" titleEn="Destination Network" standardPath="Device.DeviceInfo.ROUTE_CONFIG3_NETADDR"/>
