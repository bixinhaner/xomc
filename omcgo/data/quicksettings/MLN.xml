<?xml version="1.0" encoding="UTF-8"?>
<!--
  MLN paramModel 快速设置。
  小区参数组按 MLN 设备真值(notes/参数设置页/MLN参数整理.md)编排,字段顺序与真值一致。
  注: UlMaxOffset / DlMaxOffset 当前不在 param-mappings/MLN.xml 字典中,需要后续补字典。
  邻区配置组沿用模板生成结果,真值未提供,待校验。
-->
<quickSettings paramModel="MLN">
  <group id="enb-cell" titleZh="小区参数" titleEn="Cell Parameters">
    <param name="BandIndicator" titleZh="频段" titleEn="Band"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.FreqBandIndicator"/>
    <param name="Bandwidth" titleZh="下行带宽" titleEn="DL Bandwidth"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.DLBandwidth"/>
    <param name="ULBandWidth" titleZh="上行带宽" titleEn="UL Bandwidth"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.ULBandwidth"/>
    <param name="DLEarfcn" titleZh="频点" titleEn="EARFCN"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.EARFCNDL"/>
    <param name="SubFrameAssignment" titleZh="子帧配比" titleEn="SubFrame Assignment"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.PHY.TDDFrame.SubFrameAssignment"/>
    <param name="SpecialSubFramePatterns" titleZh="特殊子帧配置" titleEn="Special SubFrame Patterns"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.PHY.TDDFrame.SpecialSubframePatterns"/>
    <param name="PCI" titleZh="PCI" titleEn="PCI"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.PhyCellID"/>
    <param name="ECI" titleZh="ECI" titleEn="ECI"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.Common.CellIdentity"/>
    <param name="TAC" titleZh="TAC" titleEn="TAC"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.EPC.TAC"/>
    <param name="UlMaxDelay" titleZh="上行最大时延" titleEn="UL Max Delay"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.UlMaxOffset"/>
    <param name="TxOffsetCompensation" titleZh="发射偏移补偿" titleEn="Tx Offset Compensation"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.DlMaxOffset"/>
    <param name="RootSequenceIndex" titleZh="根序列索引" titleEn="rootSequenceIndex"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.PHY.PRACH.RootSequenceIndex"/>
    <param name="CellName" titleZh="小区名称" titleEn="Cell Name"
           standardPath="Device.Services.FAPService.{i}.AccessMgmt.LTE.HNBName"/>
  </group>
  <group id="enb-plmn" titleZh="服务 PLMN 列表" titleEn="Serving PLMN List">
    <param name="ExistPlmnidList" titleZh="服务 PLMN 列表" titleEn="Serving PLMN List"
           standardPath="Device.Services.FAPService.{i}.FAPControl.LTE.Gateway.ExistPlmnidList"
           maxValue="6"/>
  </group>
       <group id="device-wan-1" titleZh="WAN 配置 1" titleEn="WAN Config 1">
              <param name="IPMode" titleZh="IP 接入模式" titleEn="IP Access Mode" standardPath="Device.DeviceInfo.WAN_CONFIG1_IPMODE">
                     <option value="0" label="DHCP"/><option value="1" label="Static IP"/>
              </param>
              <param name="IPAddress" titleZh="IP 地址" titleEn="IP Address" standardPath="Device.DeviceInfo.WAN_CONFIG1_IPADDR"/>
              <param name="Netmask" titleZh="子网掩码" titleEn="Netmask" standardPath="Device.DeviceInfo.WAN_CONFIG1_NETMASK"/>
              <param name="Gateway" titleZh="网关" titleEn="Gateway" standardPath="Device.DeviceInfo.WAN_CONFIG1_DEFAULTGW"/>
              <param name="VLAN" titleZh="VLAN ID" titleEn="VLAN ID" standardPath="Device.DeviceInfo.WAN_CONFIG1_VLAN" type="unsignedInt" minValue="0" maxValue="4094"/>
              <param name="Option60" titleZh="Option60" titleEn="Option60" standardPath="Device.DeviceInfo.WAN_CONFIG1_OPTION60" type="string" maxValue="64"/>
       </group>
       <group id="device-wan-2" titleZh="WAN 配置 2" titleEn="WAN Config 2">
