       </group>
       <group id="device-static-route-1" titleZh="静态路由 1" titleEn="Static Routing 1">
              <param name="Enable" titleZh="是否生效" titleEn="Enabled" standardPath="Device.DeviceInfo.ROUTE_CONFIG1_ONBOOTENB">
                     <option value="1" label="ON"/><option value="0" label="OFF"/>
              </param>
              <param name="DestinationNetwork" titleZh="目的网络" titleEn="Destination Network" standardPath="Device.DeviceInfo.ROUTE_CONFIG1_NETADDR"/>
              <param name="Netmask" titleZh="子网掩码" titleEn="Netmask" standardPath="Device.DeviceInfo.ROUTE_CONFIG1_NETMASK"/>
              <param name="Gateway" titleZh="隧道网关" titleEn="Tunnel Gateway" standardPath="Device.DeviceInfo.ROUTE_CONFIG1_GW"/>
       </group>
       <group id="device-static-route-2" titleZh="静态路由 2" titleEn="Static Routing 2">
              <param name="Enable" titleZh="是否生效" titleEn="Enabled" standardPath="Device.DeviceInfo.ROUTE_CONFIG2_ONBOOTENB">
                     <option value="1" label="ON"/><option value="0" label="OFF"/>
              </param>
              <param name="DestinationNetwork" titleZh="目的网络" titleEn="Destination Network" standardPath="Device.DeviceInfo.ROUTE_CONFIG2_NETADDR"/>
              <param name="Netmask" titleZh="子网掩码" titleEn="Netmask" standardPath="Device.DeviceInfo.ROUTE_CONFIG2_NETMASK"/>
