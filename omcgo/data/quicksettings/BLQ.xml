<?xml version="1.0" encoding="UTF-8"?>
<quickSettings paramModel="BLQ">
  <group id="enb-cell" titleZh="小区参数" titleEn="Cell Parameters">
    <param name="ECI" titleZh="ECI" titleEn="ECI"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.Common.CellIdentity"/>
    <param name="CellName" titleZh="小区名称" titleEn="Cell Name"
           standardPath="Device.Services.FAPService.{i}.AccessMgmt.LTE.HNBName"/>
    <param name="TAC" titleZh="TAC" titleEn="TAC"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.EPC.TAC"/>
    <param name="PCI" titleZh="PCI" titleEn="PCI"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.PhyCellID"/>
    <param name="MaxTxPower" titleZh="最大发射功率" titleEn="Max Tx Power"
           standardPath="Device.Services.FAPService.{i}.Capabilities.MaxTxPower"/>
    <param name="BandSupport" titleZh="频段支持" titleEn="Band Support"
           standardPath="Device.Services.FAPService.{i}.Capabilities.LTE.BandsSupported"/>
    <param name="BandIndicator" titleZh="频段标识" titleEn="Band Indicator"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.FreqBandIndicator"/>
    <param name="DLEarfcn" titleZh="频点" titleEn="EARFCN"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.EARFCNDL"/>
    <param name="DLBandWidth" titleZh="带宽" titleEn="Bandwidth"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.DLBandwidth"/>
    <param name="SubFrameAssignment" titleZh="子帧配比" titleEn="SubFrame Assignment"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.PHY.TDDFrame.SubFrameAssignment"/>
    <param name="SpecialSubFramePatterns" titleZh="特殊子帧配置" titleEn="Special SubFrame Patterns"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.PHY.TDDFrame.SpecialSubframePatterns"/>
    <param name="RootSequenceIndex" titleZh="根序列索引" titleEn="Root Sequence Index"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.PHY.PRACH.RootSequenceIndex"/>
    <param name="CellType" titleZh="小区类型" titleEn="Cell Type"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.EnbCellType"/>
    <param name="PowerClass" titleZh="功率等级(*2dbm)" titleEn="Power Class (*2dbm)"
           standardPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.RF.X_COM_MaxTxPowerExpanded"/>
  </group>

       <group id="enb-mme" titleZh="MME IP+PLMN 列表" titleEn="MME IP + PLMN List">
              <param name="MmeIpPlmnList" titleZh="MME IP+PLMN 列表" titleEn="MME IP + PLMN List"
                                    standardPath="Device.Services.FAPService.{i}.FAPControl.LTE.Gateway.MmeIpPlmnList"/>
       </group>

  <group id="device-time" titleZh="时间与同步" titleEn="Time and Sync">
    <param name="tfcsManagerPrimsrc" titleZh="同步源" titleEn="Sync Source"
           standardPath="Device.ManagementServer.tfcsManagerPrimsrc">
      <option value="2" label="PTP"/>
      <option value="3" label="GPS"/>
      <option value="7" label="Free"/>
      <option value="8" label="Single Beidou"/>
      <option value="9" label="GLONASS"/>
      <option value="10" label="GPS+Beidou"/>
      <option value="11" label="GPS+GLONASS"/>
    </param>
    <param name="NTPServer1" titleZh="NTP 服务器 1" titleEn="NTP Server 1"
           standardPath="Device.Time.NTPServer1"/>
    <param name="NTPServer2" titleZh="NTP 服务器 2" titleEn="NTP Server 2"
           standardPath="Device.Time.NTPServer2"/>
    <param name="NTPServer3" titleZh="NTP 服务器 3" titleEn="NTP Server 3"
           standardPath="Device.Time.NTPServer3"/>
    <param name="NTPServer4" titleZh="NTP 服务器 4" titleEn="NTP Server 4"
           standardPath="Device.Time.NTPServer4"/>
    <param name="NTPServer5" titleZh="NTP 服务器 5" titleEn="NTP Server 5"
           standardPath="Device.Time.NTPServer5"/>
    <param name="LocalTimeZoneName" titleZh="本地时区" titleEn="Local Time Zone"
           standardPath="Device.Time.LocalTimeZoneName"/>
  </group>

       <group id="device-ipsec-control" titleZh="IPSec 配置" titleEn="IPSec Config">
              <param name="IPSEC_ENABLE" titleZh="IPSec 开关" titleEn="IPSec Enable"
                                    standardPath="Device.Services.FAPService.Ipsec.IPSEC_ENABLE">
                     <option value="1" label="开启"/>
                     <option value="0" label="关闭"/>
              </param>
       </group>

  <group id="device-ipsec" titleZh="IPSec 参数" titleEn="IPSec Settings"
         multiInstance="true" maxInstances="4"
         objectPath="Device.FAP.Ipsec.{i}.">
    <param name="TUNNEL_ENABLE" titleZh="TunnelEnable" titleEn="Tunnel Enable" leaf="TUNNEL_ENABLE"/>
    <param name="TUNNEL_GATEWAY" titleZh="网关地址" titleEn="Gateway" leaf="TUNNEL_GATEWAY"/>
    <param name="LEFT_AUTH" titleZh="leftAuth" titleEn="Left Auth" leaf="LEFT_AUTH"/>
    <param name="RIGHT_AUTH" titleZh="rightAuth" titleEn="Right Auth" leaf="RIGHT_AUTH"/>
    <param name="LEFT_IDENTIFIER" titleZh="leftId" titleEn="Left ID" leaf="LEFT_IDENTIFIER"/>
    <param name="RIGHT_IDENTIFIER" titleZh="rightId" titleEn="Right ID" leaf="RIGHT_IDENTIFIER"/>
    <param name="LEFTSOURCEIP" titleZh="leftSourceIp" titleEn="Left Source IP" leaf="LEFTSOURCEIP"/>
    <param name="LEFT_SUBNET" titleZh="leftSubnet" titleEn="Left Subnet" leaf="LEFT_SUBNET"/>
    <param name="RIGHT_SUBNET" titleZh="Right Subnet" titleEn="Right Subnet" leaf="RIGHT_SUBNET"/>
    <param name="FRAGMENTATION" titleZh="fragmentation" titleEn="Fragmentation" leaf="FRAGMENTATION"/>
    <param name="IKE_ENCRYPTION" titleZh="IKE Encryption" titleEn="IKE Encryption" leaf="IKE_ENCRYPTION"/>
    <param name="IKE_DH_GROUP" titleZh="IKE DH Group" titleEn="IKE DH Group" leaf="IKE_DH_GROUP"/>
    <param name="IKE_AUTHENTICATION" titleZh="IKE Authentication" titleEn="IKE Authentication" leaf="IKE_AUTHENTICATION"/>
    <param name="ESP_ENCRYPTION" titleZh="ESP Encryption" titleEn="ESP Encryption" leaf="ESP_ENCRYPTION"/>
    <param name="ESP_DH_GROUP" titleZh="ESP DH Group" titleEn="ESP DH Group" leaf="ESP_DH_GROUP"/>
    <param name="ESP_AUTHENTICATION" titleZh="ESP Authentication" titleEn="ESP Authentication" leaf="ESP_AUTHENTICATION"/>
    <param name="KEYLIFE" titleZh="KeyLife" titleEn="Key Life" leaf="KEYLIFE"/>
    <param name="IKELIFETIME" titleZh="IKELifeTime" titleEn="IKE Lifetime" leaf="IKELIFETIME"/>
    <param name="REKEYMARGIN" titleZh="RekeyMargin" titleEn="Rekey Margin" leaf="REKEYMARGIN"/>
    <param name="DPDACTION" titleZh="Dpdaction" titleEn="DPD Action" leaf="DPDACTION"/>
    <param name="DPDDELAY" titleZh="Dpddelay" titleEn="DPD Delay" leaf="DPDDELAY"/>
  </group>

  <group id="enb-neighbor-freq" titleZh="异频载波列表" titleEn="Inter-Frequency Carrier List"
         multiInstance="true" maxInstances="8"
         objectPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.Mobility.IdleMode.InterFreq.Carrier.{i}.">
    <param name="EARFCN" titleZh="频点" titleEn="EARFCN" leaf="EUTRACarrierARFCN"/>
    <param name="QOffsetRange" titleZh="频点偏移" titleEn="Q-OffsetRange" leaf="QOffsetFreq"/>
    <param name="qRxLevMinSib5" titleZh="最小接收电平" titleEn="qRxLevMinSib5" leaf="QRxLevMinSIB5"/>
    <param name="PMax" titleZh="最大发射功率" titleEn="PMax" leaf="PMax"/>
    <param name="tReselectionEutra" titleZh="重选定时器" titleEn="tReselectionEutra" leaf="TReselectionEUTRA"/>
    <param name="ReselThreshHigh" titleZh="重选高门限" titleEn="Resel Thresh High" leaf="ThreshXHigh"/>
    <param name="ReselThreshLow" titleZh="重选低门限" titleEn="Resel Thresh Low" leaf="ThreshXLow"/>
    <param name="ReselectionPriority" titleZh="重选优先级" titleEn="Reselection Priority" leaf="CellReselectionPriority"/>
    <param name="Enable" titleZh="启用" titleEn="Enable" leaf="Enable"/>
  </group>

  <group id="enb-neighbor-cell" titleZh="邻区列表" titleEn="Neighbor Cell List"
         multiInstance="true" maxInstances="32"
         objectPath="Device.Services.FAPService.{i}.CellConfig.LTE.RAN.NeighborList.LTECell.{i}.">
    <param name="CellID" titleZh="小区ID" titleEn="Cell ID" leaf="CID"
           type="unsignedInt" required="true" minValue="0" maxValue="268435455"/>
    <param name="PLMN" titleZh="PLMN" titleEn="PLMN" leaf="PLMNID"
           type="string" minValue="5" maxValue="6"/>
    <param name="EARFCN" titleZh="频点" titleEn="EARFCN" leaf="EUTRACarrierARFCN"
           type="unsignedInt" minValue="0" maxValue="65535"/>
    <param name="PCI" titleZh="PCI" titleEn="PCI" leaf="PhyCellID"
           type="unsignedInt" required="true" minValue="0" maxValue="503"/>
    <param name="QOffset" titleZh="QOffset" titleEn="QOffset" leaf="QOffset"
           type="int" defaultValue="0" minValue="-24" maxValue="24"/>
    <param name="CIO" titleZh="CIO" titleEn="CIO" leaf="CIO"
           type="int" defaultValue="0" minValue="-24" maxValue="24"/>
    <param name="TAC" titleZh="TAC" titleEn="TAC" leaf="X_COM_TAC"
           type="unsignedInt" required="true" minValue="0" maxValue="65535"/>
    <param name="Enable" titleZh="启用" titleEn="Enable" leaf="Enable"/>
    <param name="X2Status" titleZh="X2 状态" titleEn="X2 Status" leaf="X2Status"/>
    <param name="X2Flag" titleZh="X2 标记" titleEn="X2 Flag" leaf="X2Flag"
           type="string" defaultValue="0">
      <option value="0" label="SON"/>
      <option value="1" label="Manual"/>
    </param>
    <param name="X2IP" titleZh="X2 IP" titleEn="X2 IP" leaf="X2IP"/>
    <param name="NeighCellAddReason" titleZh="邻区添加原因" titleEn="Neigh Cell Add Reason" leaf="NeighCellAddReason"/>
    <param name="Blacklisted" titleZh="黑名单" titleEn="Blacklisted" leaf="Blacklisted"/>
    <param name="NeighborCellEnbType" titleZh="邻区基站类型" titleEn="eNodeB Type"
           leaf="NeighCellEnbType" type="int" defaultValue="1">
      <option value="1" label="Home"/>
      <option value="0" label="Macro"/>
    </param>
  </group>
</quickSettings>
