{
  "carrier": "cmcc",
  "technology": "lte",
  "version": "V2.3",
  "scope": "carrier_default",
  "root_object": "Device.",
  "source": "seed",
  "description": "中国移动 LTE 小基站默认数据模型 (基于移动 TR069 规范 V2.3)",
  "parameter_tree": {
    "Device.": {
      "type": "object",
      "writable": false,
      "parameters": {
        "Device.DeviceInfo.": {
          "type": "object",
          "writable": false,
          "parameters": {
            "Device.DeviceInfo.Manufacturer": {
              "type": "string",
              "writable": false,
              "description": "设备制造商名称"
            },
            "Device.DeviceInfo.ManufacturerOUI": {
              "type": "string",
              "writable": false,
              "description": "制造商 OUI (IEEE 分配)"
            },
            "Device.DeviceInfo.ModelName": {
              "type": "string",
              "writable": false,
              "description": "设备型号名称"
            },
            "Device.DeviceInfo.SerialNumber": {
              "type": "string",
              "writable": false,
              "description": "设备序列号"
            },
            "Device.DeviceInfo.HardwareVersion": {
              "type": "string",
              "writable": false,
              "description": "硬件版本号"
            },
            "Device.DeviceInfo.SoftwareVersion": {
              "type": "string",
              "writable": false,
              "description": "软件版本号"
            },
            "Device.DeviceInfo.UpTime": {
              "type": "unsignedInt",
              "writable": false,
              "description": "设备运行时长（秒）"
            },
            "Device.DeviceInfo.Description": {
              "type": "string",
              "writable": false,
              "description": "设备描述信息"
            }
          }
        },
        "Device.ManagementServer.": {
          "type": "object",
          "writable": false,
          "parameters": {
            "Device.ManagementServer.URL": {
              "type": "string",
              "writable": true,
              "description": "ACS 服务器 URL"
            },
            "Device.ManagementServer.Username": {
              "type": "string",
              "writable": true,
              "description": "CPE 访问 ACS 的用户名"
            },
            "Device.ManagementServer.Password": {
              "type": "string",
              "writable": true,
              "description": "CPE 访问 ACS 的密码"
            },
            "Device.ManagementServer.PeriodicInformEnable": {
              "type": "boolean",
              "writable": true,
              "description": "是否启用周期性 Inform"
            },
            "Device.ManagementServer.PeriodicInformInterval": {
              "type": "unsignedInt",
              "writable": true,
              "description": "周期性 Inform 间隔（秒）",
              "constraints": {
                "min_value": 60,
                "max_value": 86400
              }
            },
            "Device.ManagementServer.ConnectionRequestURL": {
              "type": "string",
              "writable": false,
              "description": "Connection Request URL"
            },
            "Device.ManagementServer.ConnectionRequestUsername": {
              "type": "string",
              "writable": true,
              "description": "ACS 发起 Connection Request 的用户名"
            },
            "Device.ManagementServer.ConnectionRequestPassword": {
              "type": "string",
              "writable": true,
              "description": "ACS 发起 Connection Request 的密码"
            },
            "Device.ManagementServer.UDPConnectionRequestAddress": {
              "type": "string",
              "writable": false,
              "description": "UDP Connection Request 地址"
            }
          }
        },
        "Device.Services.FAPService.1.": {
          "type": "object",
          "writable": false,
          "multi_instance": true,
          "parameters": {
            "Device.Services.FAPService.1.CellConfig.LTE.RAN.Common.CellIdentity": {
              "type": "unsignedInt",
              "writable": true,
              "description": "小区标识 (Cell ID)",
              "constraints": {
                "min_value": 0,
                "max_value": 268435455
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.RAN.Common.EARFCNDL": {
              "type": "unsignedInt",
              "writable": true,
              "description": "下行频点号 (EARFCN)",
              "constraints": {
                "min_value": 0,
                "max_value": 65535
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.RAN.Common.EARFCNUL": {
              "type": "unsignedInt",
              "writable": true,
              "description": "上行频点号"
            },
            "Device.Services.FAPService.1.CellConfig.LTE.RAN.RF.PhyCellID": {
              "type": "unsignedInt",
              "writable": true,
              "description": "物理小区 ID (PCI)",
              "constraints": {
                "min_value": 0,
                "max_value": 503
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.RAN.RF.ReferenceSignalPower": {
              "type": "int",
              "writable": true,
              "description": "参考信号功率 (dBm)",
              "constraints": {
                "min_value": -60,
                "max_value": 50
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.RAN.RF.DLBandwidth": {
              "type": "string",
              "writable": true,
              "description": "下行带宽",
              "constraints": {
                "enum_values": ["n6", "n15", "n25", "n50", "n75", "n100"]
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.RAN.RF.ULBandwidth": {
              "type": "string",
              "writable": true,
              "description": "上行带宽",
              "constraints": {
                "enum_values": ["n6", "n15", "n25", "n50", "n75", "n100"]
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.EPC.TAC": {
              "type": "unsignedInt",
              "writable": true,
              "description": "跟踪区编码 (TAC)",
              "constraints": {
                "min_value": 0,
                "max_value": 65535
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.EPC.PLMNList.1.PLMNID": {
              "type": "string",
              "writable": true,
              "description": "PLMN 标识 (MCC+MNC)",
              "constraints": {
                "pattern": "^[0-9]{5,6}$"
              }
            },
            "Device.Services.FAPService.1.CellConfig.LTE.EPC.PLMNList.1.Enable": {
              "type": "boolean",
              "writable": true,
              "description": "PLMN 是否启用"
            },
            "Device.Services.FAPService.1.FAPControl.LTE.AdminState": {
              "type": "boolean",
              "writable": true,
              "description": "管理状态 (true=启用)"
            },
            "Device.Services.FAPService.1.FAPControl.LTE.RFTxStatus": {
              "type": "boolean",
              "writable": false,
              "description": "射频发射状态"
            },
            "Device.Services.FAPService.1.FAPControl.LTE.OpState": {
              "type": "boolean",
              "writable": false,
              "description": "运行状态"
            },
            "Device.Services.FAPService.1.FAPControl.LTE.Gateway.SecGWServer1": {
              "type": "string",
              "writable": true,
              "description": "安全网关地址 1"
            },
            "Device.Services.FAPService.1.FAPControl.LTE.Gateway.SecGWServer2": {
              "type": "string",
              "writable": true,
              "description": "安全网关地址 2"
            },
            "Device.Services.FAPService.1.Transport.SCTP.AssocNumberOfEntries": {
              "type": "unsignedInt",
              "writable": false,
              "description": "SCTP 关联数量"
            }
          }
        },
        "Device.X_CMCC.": {
          "type": "object",
          "writable": false,
          "description": "中国移动扩展参数",
          "parameters": {
            "Device.X_CMCC.ENBId": {
              "type": "unsignedInt",
              "writable": true,
              "description": "eNodeB 标识"
            },
            "Device.X_CMCC.ENBName": {
              "type": "string",
              "writable": true,
              "description": "eNodeB 名称"
            },
            "Device.X_CMCC.SiteName": {
              "type": "string",
              "writable": true,
              "description": "站点名称"
            },
            "Device.X_CMCC.SiteId": {
              "type": "string",
              "writable": true,
              "description": "站点编号"
            },
            "Device.X_CMCC.Region": {
              "type": "string",
              "writable": true,
              "description": "所属区域"
            },
            "Device.X_CMCC.PMEnable": {
              "type": "boolean",
              "writable": true,
              "description": "性能统计是否启用"
            },
            "Device.X_CMCC.PMInterval": {
              "type": "unsignedInt",
              "writable": true,
              "description": "性能统计周期（分钟）",
              "constraints": {
                "enum_values": ["15", "30", "60"]
              }
            },
            "Device.X_CMCC.OMCDirectEnable": {
              "type": "boolean",
              "writable": true,
              "description": "OMC 直连是否启用"
            }
          }
        }
      }
    }
  }
}
