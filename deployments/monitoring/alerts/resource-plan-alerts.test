rule_files:
  - host-container-alerts.yml

evaluation_interval: 1m

tests:
  - interval: 1m
    input_series:
      - series: 'omc_resource_plan_cpu_cores{service="app"}'
        values: '2 2 2 2'
      - series: 'omc_resource_plan_cpu_cores{service="acs"}'
        values: '5 5 5 5'
      - series: 'omc_resource_plan_cpu_cores{service="worker"}'
        values: '8 8 8 8'
      - series: 'omc_resource_plan_memory_limit_bytes{service="app"}'
        values: '1610612736 1610612736 1610612736 1610612736'
      - series: 'omc_resource_plan_memory_limit_bytes{service="acs"}'
        values: '4294967296 4294967296 4294967296 4294967296'
      - series: 'omc_resource_plan_memory_limit_bytes{service="worker"}'
        values: '2147483648 2147483648 2147483648 2147483648'
      - series: 'container_spec_cpu_quota{container_label_com_docker_compose_service="worker"}'
        values: '800000 800000 800000 800000'
      - series: 'container_spec_cpu_period{container_label_com_docker_compose_service="worker"}'
        values: '100000 100000 100000 100000'
      - series: 'container_spec_memory_limit_bytes{container_label_com_docker_compose_service="worker"}'
        values: '2147483648 2147483648 2147483648 2147483648'
    alert_rule_test:
      - eval_time: 3m
        alertname: OMCResourcePlanCPUQuotaSeriesAbsent
        exp_alerts:
          - exp_labels:
              service: app
              severity: critical
              domain: omc
              subsystem: resource-plan
            exp_annotations:
              summary: "资源计划服务缺少 cAdvisor CPU quota 序列：app"
              description: "已声明资源计划的服务没有对应 cAdvisor container_spec_cpu_quota 序列。Task 8 必须核验 Docker 29/overlayfs；若持续缺失，接入 Docker API 资源 exporter 后才可上线。"
          - exp_labels:
              service: acs
              severity: critical
              domain: omc
              subsystem: resource-plan
            exp_annotations:
              summary: "资源计划服务缺少 cAdvisor CPU quota 序列：acs"
              description: "已声明资源计划的服务没有对应 cAdvisor container_spec_cpu_quota 序列。Task 8 必须核验 Docker 29/overlayfs；若持续缺失，接入 Docker API 资源 exporter 后才可上线。"
      - eval_time: 3m
        alertname: OMCResourcePlanCPUPeriodSeriesAbsent
        exp_alerts:
          - exp_labels:
              service: app
              severity: critical
              domain: omc
              subsystem: resource-plan
            exp_annotations:
              summary: "资源计划服务缺少 cAdvisor CPU period 序列：app"
              description: "已声明资源计划的服务没有对应 cAdvisor container_spec_cpu_period 序列，无法计算 CPU 实际 limit。"
          - exp_labels:
              service: acs
              severity: critical
              domain: omc
              subsystem: resource-plan
            exp_annotations:
              summary: "资源计划服务缺少 cAdvisor CPU period 序列：acs"
              description: "已声明资源计划的服务没有对应 cAdvisor container_spec_cpu_period 序列，无法计算 CPU 实际 limit。"
      - eval_time: 3m
        alertname: OMCResourcePlanMemoryLimitSeriesAbsent
        exp_alerts:
          - exp_labels:
              service: app
              severity: critical
              domain: omc
              subsystem: resource-plan
            exp_annotations:
              summary: "资源计划服务缺少 cAdvisor 内存 limit 序列：app"
              description: "已声明资源计划的服务没有对应 cAdvisor container_spec_memory_limit_bytes 序列。"
          - exp_labels:
              service: acs
              severity: critical
              domain: omc
              subsystem: resource-plan
            exp_annotations:
              summary: "资源计划服务缺少 cAdvisor 内存 limit 序列：acs"
              description: "已声明资源计划的服务没有对应 cAdvisor container_spec_memory_limit_bytes 序列。"
