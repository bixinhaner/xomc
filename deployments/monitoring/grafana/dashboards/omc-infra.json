{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "PG 连接数（主+时序）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(pg_stat_database_numbackends)", "legendFormat": "backends"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "title": "PG 连接饱和度",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 5, "y": 0},
      "targets": [
        {"expr": "sum(pg_stat_database_numbackends) / max(pg_settings_max_connections)", "legendFormat": "saturation"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.95}]}}}
    },
    {
      "title": "Redis 客户端连接",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 10, "y": 0},
      "targets": [
        {"expr": "sum(redis_connected_clients)", "legendFormat": "clients"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "title": "Redis 内存使用",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "targets": [
        {"expr": "sum(redis_memory_used_bytes)", "legendFormat": "used"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "依赖在线（nats/minio/otelcol）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
      "targets": [
        {"expr": "sum(up{job=~\"nats|minio|otelcol\"})", "legendFormat": "up"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 3}]}}}
    },

    {
      "title": "PostgreSQL 连接数（按实例）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (instance) (pg_stat_database_numbackends)", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "title": "PostgreSQL 库大小（按实例）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
      "targets": [
        {"expr": "sum by (instance) (pg_database_size_bytes)", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "PostgreSQL 事务速率（commit/rollback）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_xact_commit[$__rate_interval]))", "legendFormat": "commit"},
        {"expr": "sum(rate(pg_stat_database_xact_rollback[$__rate_interval]))", "legendFormat": "rollback"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },

    {
      "title": "Redis 内存 used vs max",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
      "targets": [
        {"expr": "redis_memory_used_bytes", "legendFormat": "used"},
        {"expr": "redis_memory_max_bytes > 0", "legendFormat": "max"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "Redis 命中率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
      "targets": [
        {"expr": "rate(redis_keyspace_hits_total[$__rate_interval]) / (rate(redis_keyspace_hits_total[$__rate_interval]) + rate(redis_keyspace_misses_total[$__rate_interval]))", "legendFormat": "hit ratio"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "title": "Redis 命令处理速率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "targets": [
        {"expr": "rate(redis_commands_processed_total[$__rate_interval])", "legendFormat": "cmds/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },

    {
      "title": "依赖容器 CPU 饱和度（占限额 %，按容器）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"(omcgo|docker)-(postgres|postgres-tsdb|redis|nats|minio|web)-.*\"}[$__rate_interval])) / (sum by (name) (container_spec_cpu_quota{name=~\"(omcgo|docker)-(postgres|postgres-tsdb|redis|nats|minio|web)-.*\"} > 0) / sum by (name) (container_spec_cpu_period{name=~\"(omcgo|docker)-(postgres|postgres-tsdb|redis|nats|minio|web)-.*\"}))", "legendFormat": "{{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "title": "依赖容器内存饱和度（占限额 %，按容器）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "sum by (name) (container_memory_working_set_bytes{name=~\"(omcgo|docker)-(postgres|postgres-tsdb|redis|nats|minio|web)-.*\"}) / (sum by (name) (container_spec_memory_limit_bytes{name=~\"(omcgo|docker)-(postgres|postgres-tsdb|redis|nats|minio|web)-.*\"}) < 64e9)", "legendFormat": "{{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}}
    },

    {
      "title": "监控栈容器内存（按容器）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {"expr": "sum by (name) (container_memory_working_set_bytes{name=~\"(omcgo|docker)-(prometheus|grafana|loki|tempo|otelcol|alertmanager|cadvisor)-.*\"})", "legendFormat": "{{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "Prometheus 时序数（head series）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {"expr": "prometheus_tsdb_head_series", "legendFormat": "head series"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "title": "TSDB 临时写入",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
      "targets": [
        {"expr": "rate(pg_stat_database_temp_bytes{instance=\"postgres-tsdb\"}[$__rate_interval])", "legendFormat": "bytes/s"},
        {"expr": "rate(pg_stat_database_temp_files{instance=\"postgres-tsdb\"}[$__rate_interval])", "legendFormat": "files/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "title": "TSDB 超过 5 秒的活跃查询",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
      "targets": [
        {"expr": "pg_active_long_queries{instance=\"postgres-tsdb\"}", "legendFormat": "{{database}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "title": "postgres-tsdb CPU / 内存饱和度",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44},
      "targets": [
        {"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"(omcgo|docker)-postgres-tsdb-.*\"}[$__rate_interval])) / sum by (name) (container_spec_cpu_quota{name=~\"(omcgo|docker)-postgres-tsdb-.*\"} / container_spec_cpu_period{name=~\"(omcgo|docker)-postgres-tsdb-.*\"})", "legendFormat": "CPU {{name}}"},
        {"expr": "container_memory_working_set_bytes{name=~\"(omcgo|docker)-postgres-tsdb-.*\"} / container_spec_memory_limit_bytes{name=~\"(omcgo|docker)-postgres-tsdb-.*\"}", "legendFormat": "memory {{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "title": "postgres-tsdb 容器磁盘读写",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44},
      "targets": [
        {"expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\"(omcgo|docker)-postgres-tsdb-.*\"}[$__rate_interval]))", "legendFormat": "read {{name}}"},
        {"expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\"(omcgo|docker)-postgres-tsdb-.*\"}[$__rate_interval]))", "legendFormat": "write {{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    }
  ],
  "schemaVersion": 39,
  "tags": ["omcgo", "infra", "dependencies"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "OMC - 依赖服务端与监控栈（PG/Redis/NATS/MinIO/监控）",
  "uid": "omcgo-infra"
}
