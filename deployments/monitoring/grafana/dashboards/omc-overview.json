{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "ACS Active Sessions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(acs_active_sessions)", "legendFormat": "Active Sessions"}
      ]
    },
    {
      "title": "Total Devices",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum(omcgo_devices_total)", "legendFormat": "Total Devices"}
      ]
    },
    {
      "title": "Active Alarms",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(omcgo_active_alarms)", "legendFormat": "Active Alarms"}
      ]
    },
    {
      "title": "Pod Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "count(up{namespace=\"omcgo\"})", "legendFormat": "Running Pods"}
      ]
    },
    {
      "title": "Inform Rate (req/s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum(rate(acs_inform_total[1m]))", "legendFormat": "Total"},
        {"expr": "sum(rate(acs_inform_total{status=\"success\"}[1m]))", "legendFormat": "Success"},
        {"expr": "sum(rate(acs_inform_total{status=\"error\"}[1m]))", "legendFormat": "Error"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"}
      }
    },
    {
      "title": "RPC Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(acs_rpc_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(acs_rpc_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(acs_rpc_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"}
      }
    },
    {
      "title": "HTTP Request Rate by Component",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum(rate(http_requests_total{namespace=\"omcgo\"}[1m])) by (component)", "legendFormat": "{{component}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"}
      }
    },
    {
      "title": "NATS JetStream Queue Depth",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "nats_jetstream_consumer_num_pending{stream=\"omcgo\"}", "legendFormat": "{{consumer}}"}
      ]
    },
    {
      "title": "CPU Usage by Pod",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"omcgo\"}[1m])) by (pod)", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit"}
      }
    },
    {
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "container_memory_working_set_bytes{namespace=\"omcgo\"}", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes"}
      }
    },
    {
      "title": "Go Runtime - Goroutines",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {"expr": "go_goroutines{namespace=\"omcgo\"}", "legendFormat": "{{pod}}"}
      ]
    },
    {
      "title": "Go Runtime - GC Pause",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {"expr": "rate(go_gc_duration_seconds_sum{namespace=\"omcgo\"}[1m])", "legendFormat": "{{pod}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"}
      }
    },
    {
      "title": "Backup Cleanup - Run Outcomes (T-0073/T-0076)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
      "targets": [
        {"expr": "sum by (result) (rate(backup_cleanup_runs_total[5m]))", "legendFormat": "{{result}}"}
      ]
    },
    {
      "title": "Backup Cleanup - Rows Deleted (rate)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
      "targets": [
        {"expr": "rate(backup_cleanup_rows_deleted_total[5m])", "legendFormat": "rows/s"}
      ]
    },
    {
      "title": "Backup Cleanup - MinIO Files Deleted (T-0076)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44},
      "targets": [
        {"expr": "rate(omc_backup_file_deleted_total[5m])", "legendFormat": "files/s"}
      ]
    },
    {
      "title": "Backup Cleanup - File Delete Errors by Reason (T-0076)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44},
      "targets": [
        {"expr": "sum by (reason) (rate(omc_backup_file_delete_errors_total[5m]))", "legendFormat": "{{reason}}"}
      ]
    },
    {
      "title": "Backup Failure Alarms Published (T-0073)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 52},
      "targets": [
        {"expr": "sum by (kind) (backup_failure_alarm_published_total)", "legendFormat": "{{kind}}"}
      ]
    },
    {
      "title": "Backup Compression Throughput by Format (T-0074/T-0077)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52},
      "targets": [
        {"expr": "sum by (format) (rate(omc_backup_compression_bytes_in_total[5m]))", "legendFormat": "{{format}} bytes/s"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "Bps"}
      }
    },
    {
      "title": "Backup Storage Usage Ratio (T-0082)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 60},
      "targets": [
        {"expr": "omc_backup_storage_usage_ratio"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 0.6},
            {"color": "red", "value": 0.8}
          ]}
        }
      }
    },
    {
      "title": "Backup Storage Used vs Capacity (T-0082)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 60},
      "targets": [
        {"expr": "omc_backup_storage_used_bytes", "legendFormat": "used"},
        {"expr": "omc_backup_storage_capacity_bytes", "legendFormat": "capacity"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes"}
      }
    },
    {
      "title": "Backup Storage Check Outcomes (T-0082)",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 60},
      "targets": [
        {"expr": "sum by (result) (rate(omc_backup_storage_check_total[1h]))", "legendFormat": "{{result}}"}
      ]
    },
    {
      "title": "Backup Storage Threshold Alarms Raised/Cleared (T-0082)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 64},
      "targets": [
        {"expr": "sum by (kind) (omc_backup_storage_threshold_alarm_total{kind=~\"raised|cleared\"})", "legendFormat": "{{kind}}"}
      ]
    },
    {
      "title": "PM Queue Depth and Delivery State",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 68},
      "targets": [
        {"expr": "omc_pm_queue_pending{subject=\"pm.file.received\",durable=\"pm-workers\"}", "legendFormat": "pending"},
        {"expr": "omc_pm_queue_ack_pending{subject=\"pm.file.received\",durable=\"pm-workers\"}", "legendFormat": "ack pending"},
        {"expr": "omc_pm_queue_redelivered{subject=\"pm.file.received\",durable=\"pm-workers\"}", "legendFormat": "redelivered"}
      ]
    },
    {
      "title": "PM Queue Age and Upload Pressure",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 68},
      "targets": [
        {"expr": "omc_pm_queue_oldest_age_seconds{subject=\"pm.file.received\",durable=\"pm-workers\"}", "legendFormat": "oldest age (s)"},
        {"expr": "acs_pm_upload_backpressure_active", "legendFormat": "pressure active"}
      ]
    },
    {
      "title": "PM Queue Delivery, Ack Rate and Backlog Slope",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 76},
      "targets": [
        {"expr": "acs_pm_queue_delivery_rate", "legendFormat": "consumer delivery/s"},
        {"expr": "acs_pm_queue_ack_rate", "legendFormat": "ack/s"},
        {"expr": "acs_pm_queue_backlog_slope", "legendFormat": "pending slope/s"}
      ]
    },
    {
      "title": "PM Backpressure Transitions and Queue Sample Health",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 76},
      "targets": [
        {"expr": "sum by (state, reason) (rate(acs_pm_upload_backpressure_transitions_total[5m]))", "legendFormat": "{{state}} / {{reason}}"},
        {"expr": "sum(rate(omc_pm_queue_sample_failures_total{subject=\"pm.file.received\",durable=\"pm-workers\"}[5m]))", "legendFormat": "sample failures/s"},
        {"expr": "time() - omc_pm_queue_sample_timestamp_seconds{subject=\"pm.file.received\",durable=\"pm-workers\"}", "legendFormat": "sample age (s)"}
      ]
    },
    {
      "title": "PM Indicator Library Drift and Disabled Values",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 84},
      "targets": [
        {
          "expr": "sum by (carrier, technology) (rate(omc_pm_whitelist_miss_values_total[5m]))",
          "legendFormat": "{{carrier}} / {{technology}} / whitelist_miss"
        },
        {
          "expr": "sum by (carrier, technology) (rate(omc_pm_known_disabled_values_total[5m]))",
          "legendFormat": "{{carrier}} / {{technology}} / known_but_disabled"
        }
      ]
    },
    {
      "title": "Dashboard KPI 查询延迟",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 92},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(dashboard_kpi_query_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(dashboard_kpi_query_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(dashboard_kpi_query_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "Dashboard KPI 并发与保护",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 92},
      "targets": [
        {"expr": "dashboard_kpi_query_inflight", "legendFormat": "inflight"},
        {"expr": "sum(rate(dashboard_kpi_query_timeout_total[$__rate_interval]))", "legendFormat": "timeout/s"},
        {"expr": "sum(rate(dashboard_kpi_query_rejected_total[$__rate_interval]))", "legendFormat": "rejected/s"}
      ]
    },
    {
      "title": "Dashboard KPI 缓存与合并",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 100},
      "targets": [
        {"expr": "sum by (result) (rate(dashboard_kpi_query_cache_total[$__rate_interval]))", "legendFormat": "cache {{result}}/s"},
        {"expr": "sum(rate(dashboard_kpi_query_coalesced_total[$__rate_interval]))", "legendFormat": "coalesced/s"}
      ]
    },
    {
      "title": "Dashboard KPI 完整性与全网上卷延迟",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 100},
      "targets": [
        {"expr": "sum by (technology, granularity) (rate(dashboard_kpi_missing_result_total[$__rate_interval]))", "legendFormat": "missing {{technology}}/{{granularity}}"},
        {"expr": "sum by (technology, granularity) (rate(dashboard_kpi_incomplete_window_total[$__rate_interval]))", "legendFormat": "incomplete {{technology}}/{{granularity}}"},
        {"expr": "max by (technology, granularity) (pm_network_rollup_lag_seconds)", "legendFormat": "lag {{technology}}/{{granularity}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "资源计划与容器实际限额 - CPU",
      "description": "声明 CPU 核数为本次完整 resources.env 的期望基线；实际限额来自 cAdvisor cgroup，使用量来自运行中容器。",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 108},
      "targets": [
        {"expr": "label_replace(sum by (container_label_com_docker_compose_service) (container_spec_cpu_quota{container_label_com_docker_compose_service=~\"app|acs|worker|postgres|postgres-tsdb|redis|nats|minio|web\"} / container_spec_cpu_period{container_label_com_docker_compose_service=~\"app|acs|worker|postgres|postgres-tsdb|redis|nats|minio|web\"}), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.*)\")", "legendFormat": "实际 CPU limit {{service}}"},
        {"expr": "label_replace(sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"app|acs|worker|postgres|postgres-tsdb|redis|nats|minio|web\"}[$__rate_interval])), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.*)\")", "legendFormat": "实际 CPU usage {{service}}"},
        {"expr": "omc_resource_plan_cpu_cores", "legendFormat": "声明 CPU 核数 {{service}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "cores"}}
    },
    {
      "title": "资源计划与容器实际限额 - 内存",
      "description": "声明内存为本次完整 resources.env 的期望基线；实际限额来自 cAdvisor cgroup，使用量是 working set。",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 108},
      "targets": [
        {"expr": "label_replace(sum by (container_label_com_docker_compose_service) (container_spec_memory_limit_bytes{container_label_com_docker_compose_service=~\"app|acs|worker|postgres|postgres-tsdb|redis|nats|minio|web\"}), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.*)\")", "legendFormat": "实际 memory limit {{service}}"},
        {"expr": "label_replace(sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service=~\"app|acs|worker|postgres|postgres-tsdb|redis|nats|minio|web\"}), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.*)\")", "legendFormat": "实际 memory usage {{service}}"},
        {"expr": "omc_resource_plan_memory_limit_bytes", "legendFormat": "声明 memory {{service}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "Redis 聚合状态与内存水位",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 116},
      "targets": [
        {"expr": "redis_memory_used_bytes", "legendFormat": "Redis dataset bytes"},
        {"expr": "redis_memory_max_bytes", "legendFormat": "Redis maxmemory"},
        {"expr": "sum by (granularity) (omc_pm_aggregation_redis_sampled_estimated_bytes)", "legendFormat": "pmagg estimated {{granularity}} bytes"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "PM 窗口关闭 - 并发与领取",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 116},
      "targets": [
        {"expr": "omc_pm_aggregation_finalize_inflight", "legendFormat": "finalize inflight"},
        {"expr": "sum(rate(omc_pm_aggregation_finalize_claims_total[$__rate_interval]))", "legendFormat": "claims/s"},
        {"expr": "sum(rate(omc_pm_aggregation_finalize_claim_conflicts_total[$__rate_interval]))", "legendFormat": "claim conflicts/s"}
      ]
    },
    {
      "title": "PM 窗口关闭 - 尾延迟",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 124},
      "targets": [
        {"expr": "omc_pm_aggregation_finalize_oldest_due_seconds", "legendFormat": "oldest due age"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "PM 重算批量与行数",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 124},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(omc_pm_aggregation_rebuild_jobs_per_batch_bucket[$__rate_interval])))", "legendFormat": "rebuild batch p95 jobs"},
        {"expr": "sum(rate(omc_pm_aggregation_rebuild_snapshot_rows_total[$__rate_interval]))", "legendFormat": "snapshot rows/s"},
        {"expr": "sum(rate(omc_pm_aggregation_rebuild_coalesced_total[$__rate_interval]))", "legendFormat": "coalesced generations/s"}
      ]
    },
    {
      "title": "PM 重算快照扫描时延",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 132},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(omc_pm_aggregation_rebuild_snapshot_scan_seconds_bucket[$__rate_interval])))", "legendFormat": "snapshot scan p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "PM 结果替换时延",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 132},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(omc_pm_aggregation_result_replace_seconds_bucket[$__rate_interval])))", "legendFormat": "TSDB result replace p95"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(omc_pm_aggregation_finalize_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "window finalize p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "PM 上卷快照发布速率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 140},
      "targets": [
        {"expr": "sum(rate(omc_pm_aggregation_rollup_outbox_published_total[$__rate_interval]))", "legendFormat": "rollup snapshots published/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "title": "Redis 聚合活动窗口数",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 148},
      "targets": [
        {"expr": "sum by (granularity) (omc_pm_aggregation_redis_sampled_active_windows)", "legendFormat": "pmagg active {{granularity}} windows"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
