{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "__comment": "饱和度面板以 cAdvisor container_spec_*（运行时真实 deploy.resources.limits）为分母，自动跟随 resources.env。哨兵 < 64e9 过滤掉未设限容器（spec_limit==整机内存）避免失真。容器正则只取 app/acs/worker，天然排除一次性 migrate-* 任务。",
  "panels": [
    {
      "title": "OMC 进程在线（app/acs/worker）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(up{job=~\"omc-.*\"})", "legendFormat": "online"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 3}]}}}
    },
    {
      "title": "最高 CPU 饱和度（占限额）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
      "targets": [
        {"expr": "max(sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}[$__rate_interval])) / (sum by (name) (container_spec_cpu_quota{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"} > 0) / sum by (name) (container_spec_cpu_period{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"})))", "legendFormat": "max"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "title": "最高 内存饱和度（占限额）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "targets": [
        {"expr": "max(sum by (name) (container_memory_working_set_bytes{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}) / (sum by (name) (container_spec_memory_limit_bytes{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}) < 64e9))", "legendFormat": "max"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "title": "连接池最高使用率",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "targets": [
        {"expr": "max(pgxpool_in_use / pgxpool_max)", "legendFormat": "max pool"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.95}]}}}
    },
    {
      "title": "容器重启次数（1h）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
      "targets": [
        {"expr": "sum(changes(container_start_time_seconds{name=~\"(omcgo|docker)-(app|acs|worker|postgres|postgres-tsdb|redis|nats|minio|web)-.*\"}[1h]))", "legendFormat": "restarts"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}}}
    },

    {
      "title": "容器 CPU 饱和度（占限额 %，按容器）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}[$__rate_interval])) / (sum by (name) (container_spec_cpu_quota{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"} > 0) / sum by (name) (container_spec_cpu_period{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}))", "legendFormat": "{{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "title": "容器 CPU 使用 vs 限额（核）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}[$__rate_interval]))", "legendFormat": "{{name}} 用量"},
        {"expr": "sum by (name) (container_spec_cpu_quota{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"} > 0) / sum by (name) (container_spec_cpu_period{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"})", "legendFormat": "{{name}} 限额"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },

    {
      "title": "容器内存饱和度（占限额 %，按容器）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum by (name) (container_memory_working_set_bytes{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}) / (sum by (name) (container_spec_memory_limit_bytes{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}) < 64e9)", "legendFormat": "{{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "title": "容器内存 使用 vs 限额（working set 对硬 OOM 线）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum by (name) (container_memory_working_set_bytes{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"})", "legendFormat": "{{name}} 用量"},
        {"expr": "sum by (name) (container_spec_memory_limit_bytes{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}) < 64e9", "legendFormat": "{{name}} 限额"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },

    {
      "title": "容器 CPU CFS 限流比（撞 CPU 限额）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "rate(container_cpu_cfs_throttled_periods_total{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}[$__rate_interval]) / rate(container_cpu_cfs_periods_total{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}[$__rate_interval])", "legendFormat": "{{name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.25}]}}}
    },
    {
      "title": "容器网络收发（按容器）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}[$__rate_interval]))", "legendFormat": "{{name}} rx"},
        {"expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"(omcgo|docker)-(app|acs|worker)-.*\"}[$__rate_interval]))", "legendFormat": "{{name}} tx"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },

    {
      "title": "Go 协程数（按服务）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
      "targets": [
        {"expr": "go_goroutines{job=~\"omc-.*\"}", "legendFormat": "{{deployment_unit}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "title": "Go 堆 vs 软限（占 GOMEMLIMIT %）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "targets": [
        {"expr": "go_memstats_heap_inuse_bytes{job=~\"omc-.*\"} / (go_gc_gomemlimit_bytes{job=~\"omc-.*\"} < 64e9)", "legendFormat": "{{deployment_unit}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.9}]}}}
    },
    {
      "title": "GC 暂停耗时速率（按服务）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "targets": [
        {"expr": "rate(go_gc_duration_seconds_sum{job=~\"omc-.*\"}[$__rate_interval])", "legendFormat": "{{deployment_unit}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },

    {
      "title": "pgxpool 使用率（按服务/池）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 36},
      "targets": [
        {"expr": "pgxpool_in_use{job=~\"omc-.*\"} / pgxpool_max{job=~\"omc-.*\"}", "legendFormat": "{{deployment_unit}}/{{pool}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 0.95}]}}}
    },
    {
      "title": "Redis 连接池使用率（按服务）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 36},
      "targets": [
        {"expr": "redis_pool_in_use{job=~\"omc-.*\"} / redis_pool_max{job=~\"omc-.*\"}", "legendFormat": "{{deployment_unit}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "title": "进程文件描述符使用率（按服务）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 36},
      "targets": [
        {"expr": "process_open_fds{job=~\"omc-.*\"} / process_max_fds{job=~\"omc-.*\"}", "legendFormat": "{{deployment_unit}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    }
  ],
  "schemaVersion": 39,
  "tags": ["omcgo", "resources", "runtime", "limits"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "OMC - 服务资源与运行时（占限额%/容器/进程/连接池）",
  "uid": "omcgo-resources"
}
