FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

ARG GOPROXY=https://mirrors.aliyun.com/goproxy/,https://goproxy.cn,https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /build

COPY omcgo/go.mod omcgo/go.sum ./
RUN go mod download

COPY omcgo/ .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/bin/omcgo-worker ./cmd/worker

# ---

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

# Create log directory with proper permissions
RUN mkdir -p /var/log/omcgo && chmod 777 /var/log/omcgo

COPY --from=builder /build/bin/omcgo-worker /usr/local/bin/omcgo-worker
COPY --from=builder /build/cmd/worker/etc/config.dev.yaml /etc/omcgo/worker.dev.yaml
COPY --from=builder /build/cmd/worker/etc/config.test.yaml /etc/omcgo/worker.test.yaml
COPY --from=builder /build/cmd/worker/etc/config.prod.yaml /etc/omcgo/worker.prod.yaml
COPY deployments/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV TZ=Asia/Shanghai
ENV OMCGO_SERVICE=worker

EXPOSE 9092

ENTRYPOINT ["/entrypoint.sh"]
