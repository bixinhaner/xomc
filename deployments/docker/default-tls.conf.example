# T-0118: TLS server block 模板（opt-in TLS termination）
#
# 使用方法：
#   1. 先跑 deployments/docker/scripts/generate-self-signed-tls.sh 生成 cert
#   2. cp default-tls.conf.example default-tls.conf
#   3. 在 docker-compose.yml web 服务挂 volume:
#        - ./certs:/etc/nginx/certs:ro
#        - ./default-tls.conf:/etc/nginx/conf.d/default-tls.conf:ro
#      并暴露端口 '443:443'
#   4. docker-compose up -d web
#   5. 浏览器访问 https://<host>（首次需手动信任自签证书）
#
# 与现有 default.conf 的关系：
#   - default.conf 保留 :8081 plain HTTP（向后兼容 / 内网测试）
#   - 本文件加 :443 ssl 作为新入口，secure context 下 Web Crypto API 可用
#   - 复用相同的 /api/ proxy_pass 和 SPA fallback 逻辑

# ============================================================
# TLS Gateway (port 443) — 复用 :8081 server 逻辑
# ============================================================
server {
    listen 443 ssl http2;
    server_name _;

    # ----- Self-signed cert (T-0118 generate-self-signed-tls.sh 生成) -----
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    # 现代 TLS 默认值
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    root  /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/app_https_access.log main;
    error_log  /var/log/nginx/app_https_error.log warn;

    # --- REST API 代理到 App ---
    # 与 default.conf :8081 server 相同；X-Forwarded-Proto=https 让 backend 知道客户端走 TLS
    location /api/ {
        proxy_pass http://app_backend/api/;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # 复用 upstream keepalive 连接
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
    }

    # --- SSE 流（运维管理 / MML 命令实时推送）---
    location ~ ^/api/v1/(ops|mml)/.*(stream|events)$ {
        proxy_pass http://app_backend;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # SSE 长连接：禁用 buffering + 长 timeout
        proxy_buffering         off;
        proxy_cache             off;
        proxy_read_timeout      24h;
        proxy_send_timeout      24h;
        chunked_transfer_encoding off;
    }

    # --- 前端 SPA fallback ---
    location / {
        try_files $uri $uri/ /index.html;

        # 静态资源缓存（Vite 构建产物带 hash，可长期缓存）
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }
}
