FROM golang:1.25-alpine AS builder

# 国内环境加速 apk 源（dl-cdn.alpinelinux.org 国内常被墙），可通过 --build-arg
# APK_MIRROR=dl-cdn.alpinelinux.org 切回官方源。
ARG APK_MIRROR=mirrors.aliyun.com
RUN sed -i "s|dl-cdn.alpinelinux.org|${APK_MIRROR}|g" /etc/apk/repositories

# 安装 git (添加重试逻辑解决 DNS 不稳定问题)
RUN for i in 1 2 3; do \
      apk add --no-cache git && break || \
      { echo "apk add attempt $i failed, retrying in 2s..."; sleep 2; }; \
    done

ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /build

COPY omcgo/go.mod omcgo/go.sum ./
RUN go mod download

COPY omcgo/ .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/bin/omcgo-acs ./cmd/acs

# ---

FROM alpine:3.19

ARG APK_MIRROR=mirrors.aliyun.com
RUN sed -i "s|dl-cdn.alpinelinux.org|${APK_MIRROR}|g" /etc/apk/repositories

RUN apk add --no-cache ca-certificates tzdata

# Create log directory with proper permissions
RUN mkdir -p /var/log/omcgo && chmod 777 /var/log/omcgo

COPY --from=builder /build/bin/omcgo-acs /usr/local/bin/omcgo-acs
COPY --from=builder /build/cmd/acs/etc/config.dev.yaml /etc/omcgo/acs.dev.yaml
COPY --from=builder /build/cmd/acs/etc/config.test.yaml /etc/omcgo/acs.test.yaml
COPY --from=builder /build/cmd/acs/etc/config.prod.yaml /etc/omcgo/acs.prod.yaml
COPY deployments/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV TZ=Asia/Shanghai
ENV OMCGO_SERVICE=acs

EXPOSE 7557 7558 9090

ENTRYPOINT ["/entrypoint.sh"]
