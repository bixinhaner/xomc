# 阶段1: 安装依赖（利用 Docker 层缓存，package.json 不变时跳过）
FROM node:20-alpine AS deps

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com

COPY omcmb/webcode/package.json omcmb/webcode/package-lock.json ./

# --legacy-peer-deps 跳过 peer dependency 版本冲突检查
RUN npm install --legacy-peer-deps

# 阶段2: 构建前端
FROM node:20-alpine AS builder

WORKDIR /app

# 仅复制构建所需源码（.dockerignore 已排除 node_modules 和 dist）
COPY omcmb/webcode/ .

# 清除可能残留的旧构建产物，确保全新构建
RUN rm -rf dist

# 从 deps 阶段覆盖正确的 node_modules（确保是 Linux 平台二进制）
COPY --from=deps /app/node_modules ./node_modules

RUN npm run build

# 验证构建产物完整性：index.html 引用的主入口文件必须存在
RUN grep -oP 'src="/assets/[^"]+\.js"' dist/index.html | grep -oP '/assets/[^"]+' | while read f; do \
      test -f "dist$f" || { echo "ERROR: build output missing: dist$f"; exit 1; }; \
    done

# 阶段3: Nginx 静态服务
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployments/docker/nginx.conf /etc/nginx/nginx.conf
COPY deployments/docker/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 8081
