FROM node:20-alpine AS builder

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com

COPY omcmb/webcode/package.json omcmb/webcode/package-lock.json ./

# npm install 会基于 lock 文件快速安装大部分依赖
# 仅重新解析平台不同的 optional deps（如 rollup darwin→linux-musl）
# --legacy-peer-deps 跳过 peer dependency 版本冲突检查
RUN npm install --legacy-peer-deps

COPY omcmb/webcode/ .

# 构建前端
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployments/docker/nginx.conf /etc/nginx/nginx.conf
COPY deployments/docker/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 8081
