FROM node:20-alpine AS builder

WORKDIR /app
COPY omcmb/webcode/package.json omcmb/webcode/package-lock.json ./

# 使用 npm install 替代 npm ci,并添加详细日志
RUN npm config set registry https://registry.npmmirror.com && \
    echo "=== Starting npm install ===" && \
    npm install --legacy-peer-deps 2>&1 && \
    echo "=== npm install completed ===" && \
    echo "=== Checking node_modules ===" && \
    ls -la node_modules/ | head -20 && \
    echo "=== Checking vite ===" && \
    ls -la node_modules/.bin/ | grep vite && \
    echo "=== vite found ==="

COPY omcmb/webcode/ .

# 构建前端
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployments/docker/nginx.conf /etc/nginx/nginx.conf
COPY deployments/docker/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 8081
