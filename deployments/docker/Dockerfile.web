FROM node:20-alpine AS builder

WORKDIR /app
COPY omcmb/webcode/package.json omcmb/webcode/package-lock.json ./

# 配置国内 npm 镜像源,添加重试逻辑
RUN for i in 1 2 3; do \
      npm config set registry https://registry.npmmirror.com && \
      npm install --legacy-peer-deps && break || \
      { echo "Install attempt $i failed, retrying in 5s..."; sleep 5; }; \
    done

COPY omcmb/webcode/ .

# 构建前端
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployments/docker/nginx.conf /etc/nginx/nginx.conf
COPY deployments/docker/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 8081
