# 阶段1: 安装依赖（利用 Docker 层缓存，package.json 不变时跳过）
#
# omcmb/ 是 npm workspaces 根（见 omcmb/package.json 的 workspaces 字段），
# 唯一权威 lock 文件是 omcmb/package-lock.json。webcode/ 已不再是独立包，
# 不能再单独 `npm ci`——必须把 workspace 根 + 全部 member 的 package.json
# 都拷进来，npm 才能验证 workspace 树并按根 lock 安装。
#
# node_modules 由 workspace hoist 到 /app/node_modules，这样 frontend-core
# 里 `import 'zustand'` 之类的模块解析能按 Node 标准行为向上查找到 /app/node_modules。
FROM node:22-alpine AS deps

# 显式声明为 development，避免宿主机 / CI / buildx 把 NODE_ENV=production 传入，
# 导致 `npm ci` 跳过 devDependencies——本项目的 vite / typescript / vitest
# 等构建工具都在 devDependencies，一旦被跳过下一 stage 就会 `sh: vite: not found`。
ENV NODE_ENV=development

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com \
    && npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-timeout 300000 \
    && npm config set maxsockets 3

# Workspace 根的 package.json + 唯一权威 lock 文件
COPY omcmb/package.json omcmb/package-lock.json ./

# 全部 4 个 workspace member 的 package.json——少一个 npm ci 会报
# "workspace not found" 拒绝安装。frontend-core(业务层) + 三套皮肤 webcode/v2/v3。
COPY omcmb/frontend-core/package.json ./frontend-core/
COPY omcmb/webcode/package.json       ./webcode/
COPY omcmb/webcode-v2/package.json    ./webcode-v2/
COPY omcmb/webcode-v3/package.json    ./webcode-v3/

# --include=dev：进一步兜底强制安装 devDependencies（即使 NODE_ENV 意外被改）
# --legacy-peer-deps：跳过 peer dependency 版本冲突检查
# 用 npm ci 而非 npm install：严格遵循 package-lock.json，保证不同机器 / CI
# 上解析到完全一致的依赖树和 .bin 符号链接，避免"本机 OK 服务器报错"。
RUN npm ci --include=dev --legacy-peer-deps

# 阶段2: 构建前端
FROM node:22-alpine AS builder

# 与 deps 阶段对齐：NODE_ENV 固定 development，防止 vite build 时误判为 prod-only
# 环境导致的行为差异（某些插件会在 production 时跳过某些构建步骤）。
# vite build 本身会把产物里的 process.env.NODE_ENV 写为 production，不受本 ENV 影响。
ENV NODE_ENV=development

WORKDIR /app

# 从 deps 拷整个 /app（含 workspace 根 package.json、根 lock、hoist 后的 node_modules
# 以及各 member 目录下的占位 package.json + 可能的小 node_modules）
COPY --from=deps /app/ ./

# 覆盖源码：三套皮肤 webcode/v2/v3（构建目标）+ frontend-core（@core alias 依赖源）
# .dockerignore 已排除 node_modules / dist，不会污染 deps 装出来的 node_modules
COPY omcmb/webcode/       ./webcode/
COPY omcmb/webcode-v2/    ./webcode-v2/
COPY omcmb/webcode-v3/    ./webcode-v3/
COPY omcmb/frontend-core/ ./frontend-core/

# 清除可能残留的旧构建产物
RUN rm -rf webcode/dist webcode-v2/dist webcode-v3/dist

# 应用版本号注入：build-release.sh 通过 --build-arg APP_VERSION=$VERSION 传入
# （形如 1.0.0-20260522-1530），vite build 读取 VITE_APP_VERSION 内联进产物，
# 左侧菜单底部据此显示。未传时默认空串 → 前端回退 'dev'。
ARG APP_VERSION=""
ENV VITE_APP_VERSION=$APP_VERSION

# 通过 workspace 入口构建三套皮肤；npm 会自动把 /app/node_modules/.bin
# 注入到子 workspace 的执行环境，所以不需要手动设置 PATH。
# v2/v3 的 base(/v2/、/v3/) 在各自 vite.config.ts 内固化，无需 --base 传参。
RUN npm run build --workspace webcode \
    && npm run build --workspace webcode-v2 \
    && npm run build --workspace webcode-v3

# 验证三套构建产物完整性：index.html 引用的主入口文件必须存在。
# 注意 v2/v3 的 URL 带 base 前缀(/v2//v3/)，但产物文件落在各自 dist/assets/ 下
# （dist 根即映射到 /v2/、/v3/），校验时需把 URL 的 base 前缀剥掉再 test -f。
RUN for d in webcode webcode-v2 webcode-v3; do \
      grep -oE '/(v2/|v3/)?assets/[^"]+\.js' "$d/dist/index.html" | while read f; do \
        rel=$(echo "$f" | sed -E 's#^/(v2/|v3/)#/#'); \
        test -f "$d/dist$rel" || { echo "ERROR: build output missing: $d/dist$rel (url $f)"; exit 1; }; \
      done; \
    done

# 阶段3: Nginx 静态服务
# v1 在根，v2/v3 各自子目录（与 default.conf 的 /v2/ /v3/ location + 各自 base 对应）
FROM nginx:alpine
COPY --from=builder /app/webcode/dist    /usr/share/nginx/html
COPY --from=builder /app/webcode-v2/dist /usr/share/nginx/html/v2
COPY --from=builder /app/webcode-v3/dist /usr/share/nginx/html/v3
COPY deployments/docker/nginx.conf /etc/nginx/nginx.conf
COPY deployments/docker/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 8081
