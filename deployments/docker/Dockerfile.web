FROM node:20-alpine AS builder

WORKDIR /app
COPY omcmb/webcode/package.json omcmb/webcode/package-lock.json ./

# npm ci 添加重试逻辑解决网络不稳定问题
RUN for i in 1 2 3; do \
      npm config set registry https://registry.npmmirror.com && npm ci && break || \
      { echo "npm ci attempt $i failed, retrying in 3s..."; sleep 3; }; \
    done

COPY omcmb/webcode/ .

# 确保 node_modules/.bin 在 PATH 中,并验证 vite 已安装
RUN export PATH="/app/node_modules/.bin:$PATH" && \
    which vite || (echo "ERROR: vite not found after npm ci" && ls -la node_modules/.bin/ && exit 1) && \
    npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployments/docker/nginx.conf /etc/nginx/nginx.conf
COPY deployments/docker/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 8081
