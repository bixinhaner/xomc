[Unit]
Description=OMC ACS Service (omcgo-acs)
After=network.target docker.service
Requires=docker.service
# 崩溃循环熔断：300 秒内重启达 5 次即进入 failed 态、停止重试。
# 「停止重试」是有意为之——让 Prometheus up==0 告警明确暴露「修不好」，
# 而非无限重启刷日志掩盖故障（配合告警通知链 T-0149）。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Type=notify：进程经 sd_notify 上报 READY=1 后 systemd 才视为启动完成；
# 配合 WatchdogSec 实现卡死检测。喂狗逻辑见 internal/core/components/sdnotify。
Type=notify
NotifyAccess=main
# WorkingDirectory 必须是 current 软链：omcgo-acs 按相对路径加载 data/、configs/
WorkingDirectory=/opt/omc/current
ExecStart=/opt/omc/current/bin/omcgo-acs --config /opt/omc/etc/acs.prod.yaml
Restart=on-failure
RestartSec=5s
# 看门狗：进程须每 ≤15s 喂狗一次（sdnotify 按 WatchdogSec/2 自动喂）。
# 进程完全卡死（runtime 死锁、所有线程阻塞）时喂狗 goroutine 无法运行，
# systemd 超 30s 未收到心跳即重启——这是 Restart=on-failure 抓不到的故障
# （进程并未退出）。依赖级阻塞（DB 调用挂住）不在此检测，由 /readyz + 告警覆盖。
WatchdogSec=30s
# 启动期上限：初始化含 DB/Redis/NATS/MinIO 连接 + 字典加载，放宽到 5 分钟。
TimeoutStartSec=300s
LimitNOFILE=65536
Environment=OMCGO_ENV=prod
Environment=TZ=Asia/Shanghai

[Install]
WantedBy=multi-user.target
