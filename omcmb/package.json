{
  "name": "omcmb",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend-core",
    "webcode",
    "webcode-v2",
    "webcode-v3"
  ],
  "description": "OMC 前端 workspace 根：frontend-core (共享业务层) + webcode (v1 经典皮肤) + webcode-v2 (shadcn 极简皮肤) + webcode-v3 (STARFORGE 沉浸式 HUD 皮肤)",
  "scripts": {
    "lint": "eslint webcode/src webcode-v2/src webcode-v3/src frontend-core/src",
    "lint:fix": "eslint webcode/src webcode-v2/src webcode-v3/src frontend-core/src --fix",
    "typecheck": "npm run typecheck --workspace webcode",
    "typecheck:v3": "npm run typecheck --workspace webcode-v3",
    "dev:v3": "npm run dev --workspace webcode-v3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3"
  },
  "comment:overrides": "#3 前端安全加固：把存在已知 CVE 的传递依赖钉到已修复版本（业务代码未直接引用这些包，均经 pro-components / ahooks / react-router-dom / openlayers 间接引入）。xlsx 的修复版仅在 SheetJS CDN 发布、npm 公共 registry 最高 0.18.5，无法经 overrides 修复，见 PR 遗留项。",
  "overrides": {
    "axios": "^1.17.0",
    "path-to-regexp": "^8.4.2",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "js-cookie": "^3.0.6",
    "brace-expansion": "^2.0.2",
    "protocol-buffers-schema": "^3.6.1",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4"
  }
}
