VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK=false

VITE_MAP_TILE_URL=http://192.168.20.31:8050/{z}/{x}/{y}.png

# 菜单动态加载灰度开关（PRD docs/prd/system/menu-dynamic-loading.md §4.3）
# - false（默认）：Sidebar 用硬编码 NAV_CONFIG；不调 GET /auth/menus
# - true：Sidebar 来自后端菜单树；首屏 MenuBootstrap 阻塞直到拉取完成或 persist 命中
VITE_DYNAMIC_MENU=false
