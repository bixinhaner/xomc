VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK=false

# 离线地图瓦片服务（相对路径，走 Vite 代理）
VITE_MAP_TILE_URL=/tiles/{z}/{x}/{y}.png

# 瓦片代理目标（指向测试服务器，换服务器时修改此配置即可）
VITE_TILES_PROXY_TARGET=http://172.19.1.73:8081

# 菜单动态加载灰度开关（PRD docs/prd/system/menu-dynamic-loading.md §4.3）
# - false（默认）：Sidebar 用硬编码 NAV_CONFIG；不调 GET /auth/menus
# - true：Sidebar 来自后端菜单树；首屏 MenuBootstrap 阻塞直到拉取完成或 persist 命中
VITE_DYNAMIC_MENU=true
