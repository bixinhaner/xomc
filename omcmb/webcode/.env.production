VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK=false

# 菜单动态加载灰度开关（PRD docs/prd/system/menu-dynamic-loading.md §4.3）
# - false：Sidebar 用硬编码 NAV_CONFIG；不调 GET /auth/menus（所有非超管用户看到相同菜单）
# - true：Sidebar 来自后端 GET /auth/menus，按角色 role_menus 关联过滤（test 等非超管角色只看部分菜单）
# Vite 在 production build 时按 mode=production 加载本文件；不显式设置则 featureFlag.ts
# 走 ?? 'false' 默认值，bundle 里被硬编码成 false，改 .env.development 也不生效。
VITE_DYNAMIC_MENU=true

# 离线地图服务地址（生产环境按需配置）
# 示例: http://192.168.20.31:8050/{z}/{x}/{y}.png
# 如果不需要离线地图，留空或注释掉即可使用在线地图
#VITE_MAP_TILE_URL=
