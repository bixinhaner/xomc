{
  "name": "webcode-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OMC 前端 v3 皮肤 — STARFORGE 沉浸式指挥舰桥 HUD（Cyber NOC + Glassmorphism + 3D Holo）。消费 @omc/frontend-core 共享业务层。",
  "scripts": {
