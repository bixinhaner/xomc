    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omc/frontend-core": "*",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.17.0",
